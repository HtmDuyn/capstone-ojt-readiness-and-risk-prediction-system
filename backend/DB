CREATE TRIGGER "TR_Coordination_Validate" BEFORE INSERT OR UPDATE ON public."StudentEnterpriseCoordination"
FOR EACH ROW EXECUTE FUNCTION public."validate_ojt_coordination"();

CREATE OR REPLACE FUNCTION public."validate_internship_assignment"() RETURNS trigger
LANGUAGE plpgsql SET search_path=public AS $f$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM public."StudentEnterpriseCoordination" c JOIN public."OJTRegistrations" r USING ("RegistrationID")
    WHERE c."CoordinationID"=NEW."CoordinationID" AND c."Decision"='ACCEPTED' AND r."StudentID"=NEW."StudentID"
      AND c."EnterpriseID"=NEW."EnterpriseID" AND c."PositionID"=NEW."PositionID") THEN
    RAISE EXCEPTION 'Assignment must match an accepted coordination for this student';
  END IF;
  IF NEW."StartDate" IS NOT NULL AND NEW."EndDate" IS NOT NULL AND NEW."EndDate"<NEW."StartDate" THEN RAISE EXCEPTION 'Assignment end date must not precede start date'; END IF;
  RETURN NEW;
END $f$;
