 INSERT INTO "Users" ("Username","PasswordHash","Email","Phone","FullName","RoleID","Status")
 SELECT 'student'||lpad(d.n::text,2,'0'),'$2b$10$4qpatgMq9N2Fgc.qnWP4keLOFOTuazu8A9d67lUS9gn/AyhWHHCV.',
 'student'||lpad(d.n::text,2,'0')||'@student.edu.vn','090100'||lpad(d.n::text,4,'0'),d.full_name,r."RoleID",'ACTIVE'
