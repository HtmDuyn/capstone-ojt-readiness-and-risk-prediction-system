CREATE OR REPLACE FUNCTION set_updated_at()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
BEGIN
    NEW.UpdatedAt = CURRENT_TIMESTAMP;
    RETURN NEW;
END;
$$;


CREATE TRIGGER TRG_Users_UpdatedAt
BEFORE UPDATE ON Users
FOR EACH ROW
EXECUTE FUNCTION set_updated_at();


