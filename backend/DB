-- Supabase: API client khong duoc truy cap bang nghiep vu truc tiep.
-- Backend dung service_role (giu tren server), xu ly authorization theo vai tro.
DO $block$
DECLARE t record;
BEGIN
  FOR t IN SELECT tablename FROM pg_tables WHERE schemaname = 'public'
    AND tablename = ANY (ARRAY[
      'Roles','Permissions','RolePermissions','Users','AcademicYears','OJTSemesters',
      'TrainingPrograms','Courses','CoursePrerequisites','ProgramCourses','Students',
      'StudentCourseResults','StudentAcademicSnapshot','OJTEligibilityConditions',
      'StudentOJTEligibility','AIModels','AIModelConfig','RiskPredictions',
      'PathwayRecommendations','SupportClassAISuggestions','SupportClasses',
      'SupportClassRegistrations','Enterprises','EnterpriseUsers','InternshipPositions',
      'OJTRegistrations','StudentEnterpriseCoordination','InternshipAssignments',
      'InternshipTasks','TaskProgressUpdates','IncidentReports','InternshipEvaluations',
      'NotificationTemplates','Notifications','SupportRequests','AuditLogs',
      'Curricula','CurriculumCohorts','CurriculumCourses','CurriculumCombos',
      'CurriculumComboCourses','CurriculumPrerequisiteOptions','StudentComboSelections','OJTRuleSets'])
  LOOP
    EXECUTE format('ALTER TABLE public.%I ENABLE ROW LEVEL SECURITY', t.tablename);
    EXECUTE format('REVOKE ALL ON TABLE public.%I FROM anon, authenticated', t.tablename);
    EXECUTE format('GRANT SELECT, INSERT, UPDATE, DELETE ON TABLE public.%I TO service_role', t.tablename);
  END LOOP;
END $block$;
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO service_role;

