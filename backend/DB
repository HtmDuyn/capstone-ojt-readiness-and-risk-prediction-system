CREATE OR REPLACE FUNCTION public."validate_student_curriculum"() RETURNS trigger
LANGUAGE plpgsql SET search_path = public AS $block$
DECLARE expected_curriculum bigint;
BEGIN
  IF TG_TABLE_NAME = 'StudentComboSelections' THEN
    SELECT "CurriculumID" INTO expected_curriculum FROM public."Students" WHERE "StudentID" = NEW."StudentID";
    IF expected_curriculum IS DISTINCT FROM NEW."CurriculumID" THEN
      RAISE EXCEPTION 'Student and combo curriculum do not match';
    END IF;
  ELSIF NEW."CurriculumID" IS NOT NULL AND NEW."CohortCode" IS NOT NULL THEN
    IF NOT EXISTS (SELECT 1 FROM public."CurriculumCohorts" WHERE "CurriculumID" = NEW."CurriculumID" AND "CohortCode" = NEW."CohortCode") THEN
      RAISE EXCEPTION 'Student cohort does not belong to curriculum';
    END IF;
  END IF;
  IF TG_TABLE_NAME = 'Students' AND EXISTS (
    SELECT 1 FROM public."StudentComboSelections" s WHERE s."StudentID" = NEW."StudentID" AND s."CurriculumID" IS DISTINCT FROM NEW."CurriculumID"
  ) THEN
    RAISE EXCEPTION 'Change or remove student combo selections before changing curriculum';
  END IF;
  RETURN NEW;
END $block$;
DROP TRIGGER IF EXISTS "TR_Students_Curriculum" ON public."Students";
CREATE TRIGGER "TR_Students_Curriculum" BEFORE INSERT OR UPDATE OF "CurriculumID", "CohortCode" ON public."Students"
FOR EACH ROW EXECUTE FUNCTION public."validate_student_curriculum"();
