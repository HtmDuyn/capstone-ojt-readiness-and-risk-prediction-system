CREATE UNIQUE INDEX IF NOT EXISTS "UQ_Coordination_OneAccepted" ON public."StudentEnterpriseCoordination"("RegistrationID") WHERE "Decision"='ACCEPTED';
CREATE OR REPLACE FUNCTION public."validate_ojt_coordination"() RETURNS trigger
LANGUAGE plpgsql SET search_path=public AS $f$
DECLARE reg public."OJTRegistrations"%ROWTYPE; pos public."InternshipPositions"%ROWTYPE; used_slots integer; need_review boolean;
BEGIN
  SELECT * INTO reg FROM public."OJTRegistrations" WHERE "RegistrationID"=NEW."RegistrationID" FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION 'OJT registration not found'; END IF;
  SELECT * INTO pos FROM public."InternshipPositions" WHERE "PositionID"=NEW."PositionID" FOR UPDATE;
  IF NOT FOUND OR pos."EnterpriseID"<>NEW."EnterpriseID" OR pos."OJTSemesterID"<>reg."OJTSemesterID" THEN
    RAISE EXCEPTION 'Position, enterprise and OJT semester do not match';
  END IF;
  IF TG_OP='INSERT' OR NEW."Decision" IN ('PENDING','ACCEPTED') THEN
  IF NOT EXISTS (SELECT 1 FROM public."StudentOJTEligibility" WHERE "StudentID"=reg."StudentID" AND "OJTSemesterID"=reg."OJTSemesterID" AND "Status"='ELIGIBLE') THEN
    RAISE EXCEPTION 'Only OJT-eligible students can be coordinated';
  END IF;
  SELECT "RequireAcademicApproval" INTO need_review FROM public."OJTRegistrationPolicies" WHERE "OJTSemesterID"=reg."OJTSemesterID";
  IF NOT FOUND THEN SELECT ("SettingValue" #>> '{}')::boolean INTO need_review FROM public."SystemSettings" WHERE "SettingKey"='ojt.require_academic_approval'; END IF;
  IF coalesce(need_review,false) AND reg."ReviewDecision" IS DISTINCT FROM 'APPROVED' THEN RAISE EXCEPTION 'Academic approval is required before coordination'; END IF;
  END IF;
  IF NEW."PreviousCoordinationID" IS NOT NULL AND (NEW."PreviousCoordinationID"=NEW."CoordinationID" OR NOT EXISTS (
    SELECT 1 FROM public."StudentEnterpriseCoordination" WHERE "CoordinationID"=NEW."PreviousCoordinationID" AND "RegistrationID"=NEW."RegistrationID"
  )) THEN RAISE EXCEPTION 'Previous coordination must belong to the same registration'; END IF;
  IF NEW."Decision"='ACCEPTED' THEN
    SELECT count(*) INTO used_slots FROM public."StudentEnterpriseCoordination" WHERE "PositionID"=NEW."PositionID" AND "Decision"='ACCEPTED' AND "CoordinationID"<>NEW."CoordinationID";
    IF pos."Capacity" IS NULL OR pos."Capacity"<0 OR used_slots>=pos."Capacity" THEN RAISE EXCEPTION 'Internship position has no available capacity'; END IF;
  END IF;
  RETURN NEW;
END $f$;
