-- Lịch sử combo CANCELLED không ngăn cập nhật curriculum; lựa chọn ACTIVE phải cùng curriculum.
CREATE OR REPLACE FUNCTION public."validate_student_curriculum"() RETURNS trigger
LANGUAGE plpgsql SET search_path=public AS $f$
DECLARE expected_curriculum bigint;
BEGIN
 IF TG_TABLE_NAME='StudentComboSelections' THEN
   SELECT "CurriculumID" INTO expected_curriculum FROM public."Students" WHERE "StudentID"=NEW."StudentID";
   IF expected_curriculum IS DISTINCT FROM NEW."CurriculumID" THEN RAISE EXCEPTION 'Student and combo curriculum do not match'; END IF;
 ELSE
   IF NEW."CurriculumID" IS NOT NULL AND NEW."CohortCode" IS NOT NULL AND NOT EXISTS (SELECT 1 FROM public."CurriculumCohorts" WHERE "CurriculumID"=NEW."CurriculumID" AND "CohortCode"=NEW."CohortCode") THEN
     RAISE EXCEPTION 'Student cohort does not belong to curriculum';
   END IF;
   IF EXISTS (SELECT 1 FROM public."StudentComboSelections" WHERE "StudentID"=NEW."StudentID" AND "Status"='ACTIVE' AND "CurriculumID" IS DISTINCT FROM NEW."CurriculumID") THEN
     RAISE EXCEPTION 'Cancel active combo selections before changing curriculum';
   END IF;
 END IF;
 RETURN NEW;
END $f$;

