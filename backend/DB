 'SE'||right(entry_year::text,2)||chr(65+(d.n-1)%4),'ACTIVE'
 FROM _demo_student_cases d JOIN "Users" u ON u."Username"='student'||lpad(d.n::text,2,'0');
 INSERT INTO "StudentAcademicPlacements" ("StudentID","CohortID","GroupCode","EntryAcademicPeriodID","CurrentAcademicPeriodID","UpdatedBy")
 SELECT s."StudentID",cohort_id,chr(65+(d.n-1)%4),entry_id,prep_id,actor_id
 FROM _demo_student_cases d JOIN "Users" u ON u."Username"='student'||lpad(d.n::text,2,'0') JOIN "Students" s ON s."UserID"=u."UserID";

 -- Insert in curriculum order, so eligibility uses only earlier passed attempts.
 FOR study_stage IN 0..5 LOOP
 -- Completed coursework preserves curriculum stages 0..5, including stage 0.
 -- Vary scores by stable course codes, not global identity sequence values.
 INSERT INTO "StudentCourseResults" ("StudentID","CourseID","SemesterTaken","AcademicYearID","AcademicPeriodID","AttemptNumber","Score","Grade","Status","SourceReference","RecordedBy")
 SELECT student."StudentID",pc."CourseID",pc."RecommendedSemester",period."AcademicYearID",period."AcademicPeriodID",1,
 mark.score,CASE WHEN mark.score IS NULL THEN NULL WHEN mark.score<5 THEN 'F' WHEN mark.score>=8 THEN 'A' WHEN mark.score>=7 THEN 'B' WHEN mark.score>=6 THEN 'C' ELSE 'D' END,
 CASE WHEN mark.score IS NULL THEN 'WITHDRAWN' WHEN mark.score<5 THEN 'FAILED' ELSE 'PASSED' END,
 'DEMO-20-STUDENTS:FINALIZED-CURRICULUM-0-5',actor_id
 FROM _demo_student_cases d JOIN "Users" u ON u."Username"='student'||lpad(d.n::text,2,'0') JOIN "Students" student ON student."UserID"=u."UserID"
 CROSS JOIN "ProgramCourses" pc JOIN "Courses" course ON course."CourseID"=pc."CourseID"
 JOIN _demo_study_periods plan ON plan.stage=pc."RecommendedSemester"
 JOIN "AcademicPeriods" period ON period."AcademicPeriodID"=plan.period_id
 CROSS JOIN LATERAL (SELECT CASE
  WHEN d.withdraw_fifth AND pc."RecommendedSemester"=5 THEN NULL
  WHEN course."CourseCode"=ANY(d.failed_codes) THEN round(2.5+((d.n+ascii(course."CourseCode"))%11)*0.2,2)
  ELSE round(least(9.8,greatest(5.0,d.base_score+(((ascii(course."CourseCode")+length(course."CourseCode")+d.n)%5)-2)*0.15)),2)
 END AS score) mark
 WHERE pc."ProgramID"=program_id AND pc."RecommendedSemester"=study_stage
 AND NOT EXISTS (
  SELECT 1 FROM "ProgramPrerequisiteGroups" g WHERE g."ProgramCourseID"=pc."ProgramCourseID"
  AND (SELECT count(*) FROM "ProgramPrerequisiteMembers" m WHERE m."GroupID"=g."GroupID"
   AND EXISTS(SELECT 1 FROM "StudentCourseResults" passed WHERE passed."StudentID"=student."StudentID"
    AND passed."CourseID"=m."CourseID" AND passed."Status" IN ('PASSED','RECOGNIZED')
    AND passed."SemesterTaken"<study_stage))<g."MinimumPassed"
 );
 END LOOP;

 -- Resits in stage 5 use earlier subjects (stage 1), never a second result in the same semester.
 INSERT INTO "StudentCourseResults" ("StudentID","CourseID","SemesterTaken","AcademicYearID","AcademicPeriodID","AttemptNumber","Score","Grade","Status","SourceReference","RecordedBy")
 SELECT student."StudentID",course."CourseID",5,year_id,prep_id,2,mark.score,
 CASE WHEN mark.score>=8 THEN 'A' WHEN mark.score>=7 THEN 'B' WHEN mark.score>=6 THEN 'C' ELSE 'D' END,
 'PASSED','DEMO-20-STUDENTS:SEMESTER-5-RESIT',actor_id
 FROM _demo_student_cases d JOIN "Users" u ON u."Username"='student'||lpad(d.n::text,2,'0') JOIN "Students" student ON student."UserID"=u."UserID"
 JOIN "Courses" course ON course."CourseCode"=ANY(d.failed_codes)
 CROSS JOIN LATERAL (SELECT round(least(9.8,d.base_score+0.35),2) AS score) mark
 WHERE d.passed_retake;

 -- OJT202, ENW493c and unfinished retakes in semester 6 have not started yet.
 -- Keep them in the curriculum; do not invent IN_PROGRESS rows or grades in the future.

 INSERT INTO "OJTRuleSets" ("ProgramID","OJTSemesterID","Version","Name","CreatedBy","Status","PublishedBy","PublishedAt")
