/*
============================================================
50. DEMO QUERY - AI RISK DASHBOARD
============================================================
*/

SELECT
    s.StudentCode,
    u.FullName,
    sas.GPA,
    sas.AccumulatedCredits,
    sas.RemainingCredits,
    sas.FailedCoursesCount,
    rp.RiskProbability,
    rp.RiskLevel,
    rp.PredictedAt
FROM Students s
JOIN Users u
    ON u.UserID = s.UserID
LEFT JOIN StudentAcademicSnapshot sas
    ON sas.StudentID = s.StudentID
LEFT JOIN RiskPredictions rp
    ON rp.StudentID = s.StudentID
WHERE sas.SnapshotID IS NULL
   OR sas.SnapshotDate = (
        SELECT MAX(sas2.SnapshotDate)
        FROM StudentAcademicSnapshot sas2
        WHERE sas2.StudentID = s.StudentID
   )
ORDER BY
    rp.RiskProbability DESC NULLS LAST;


/*
============================================================
51. DEMO QUERY - STUDENT PATHWAY
============================================================
*/

SELECT
    s.StudentCode,
    u.FullName,
    rp.RiskLevel,
    rp.RiskProbability,
    pr.MissingCourses,
    pr.RecommendedPlan,
    pr.Status
FROM PathwayRecommendations pr
JOIN Students s
    ON s.StudentID = pr.StudentID
JOIN Users u
    ON u.UserID = s.UserID
LEFT JOIN RiskPredictions rp
    ON rp.PredictionID = pr.PredictionID
ORDER BY
    rp.RiskProbability DESC NULLS LAST;


/*
============================================================
52. DEMO QUERY - OJT REGISTRATION
============================================================
*/

SELECT
    s.StudentCode,
    u.FullName,
    e.Name AS Enterprise,
    ip.Title AS Position,
    ojts.SemesterCode,
    r.Status
FROM OJTRegistrations r
JOIN Students s
    ON s.StudentID = r.StudentID
JOIN Users u
    ON u.UserID = s.UserID
JOIN OJTSemesters ojts
    ON ojts.OJTSemesterID = r.OJTSemesterID
LEFT JOIN InternshipPositions ip
    ON ip.PositionID = r.PreferredPositionID
LEFT JOIN Enterprises e
    ON e.EnterpriseID = ip.EnterpriseID
ORDER BY r.RegisteredAt DESC;


