   s."StartsAt"<(NEW."StartDate"::timestamp AT TIME ZONE 'Asia/Bangkok') OR s."EndsAt">((NEW."EndDate"+1)::timestamp AT TIME ZONE 'Asia/Bangkok'))) OR
 EXISTS (SELECT 1 FROM "OJTAssessmentWindows" w WHERE w."BlockPeriodID"=NEW."AcademicPeriodID" AND
  (NEW."Kind"<>'BLOCK3' OR w."OpensAt"<((NEW."EndDate"+1)::timestamp AT TIME ZONE 'Asia/Bangkok'))) THEN
