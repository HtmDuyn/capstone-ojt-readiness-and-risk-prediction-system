 SELECT program_id,term_id,"CourseID",target_period,'[{"minimumScore":0,"outcome":"FAILED","grade":"F"},{"minimumScore":5,"outcome":"PASSED","grade":"D"},{"minimumScore":6,"outcome":"PASSED","grade":"C"},{"minimumScore":7,"outcome":"PASSED","grade":"B"},{"minimumScore":8,"outcome":"PASSED","grade":"A"}]'::jsonb,
 'Ánh xạ OJT của chương trình minh họa, thang 10',actor_id FROM "Courses" WHERE "CourseCode"='OJT202';
END $students$;

-- Cache only values derived from the actual attempts. The backend still recalculates
-- GPA/credits itself and official eligibility is confirmed through the normal workflow.
INSERT INTO "StudentAcademicSnapshot" ("StudentID","SnapshotDate","GPA","AccumulatedCredits","RemainingCredits","FailedCoursesCount","CurrentSemester","TargetOJTSemesterID")
SELECT s."StudentID",current_date,
 (SELECT round(sum(r."Score"*pc."Credits")/NULLIF(sum(pc."Credits"),0),2) FROM (
  SELECT DISTINCT ON (r."CourseID") r.* FROM "StudentCourseResults" r JOIN "AcademicPeriods" ap ON ap."AcademicPeriodID"=r."AcademicPeriodID"
  WHERE r."StudentID"=s."StudentID" AND r."Status" IN ('PASSED','FAILED') ORDER BY r."CourseID",ap."StartDate" DESC,r."AttemptNumber" DESC,r."ResultID" DESC
 ) r JOIN "ProgramCourses" pc ON pc."CourseID"=r."CourseID" AND pc."ProgramID"=s."ProgramID"),
 totals.earned,p."TotalCredits"-totals.earned,totals.failed,s."CurrentSemester",o."OJTSemesterID"
FROM "Students" s JOIN "TrainingPrograms" p ON p."ProgramID"=s."ProgramID"
CROSS JOIN "OJTSemesters" o CROSS JOIN LATERAL (
 SELECT coalesce(sum(pc."Credits") FILTER (WHERE EXISTS(SELECT 1 FROM "StudentCourseResults" r WHERE r."StudentID"=s."StudentID" AND r."CourseID"=pc."CourseID" AND r."Status" IN ('PASSED','RECOGNIZED'))),0)::int AS earned,
 count(*) FILTER (WHERE EXISTS(SELECT 1 FROM "StudentCourseResults" r WHERE r."StudentID"=s."StudentID" AND r."CourseID"=pc."CourseID" AND r."Status"='FAILED') AND NOT EXISTS(SELECT 1 FROM "StudentCourseResults" r WHERE r."StudentID"=s."StudentID" AND r."CourseID"=pc."CourseID" AND r."Status" IN ('PASSED','RECOGNIZED')))::int AS failed
 FROM "ProgramCourses" pc WHERE pc."ProgramID"=s."ProgramID"
) totals WHERE p."ProgramCode"='DEMO-SE-FULL' AND o."SemesterCode"='DEMO-OJT-S6';
