CREATE OR REPLACE FUNCTION public."validate_combo_registration"() RETURNS trigger
LANGUAGE plpgsql SET search_path=public AS $f$
DECLARE w public."ComboRegistrationWindows"%ROWTYPE; actual_type text; actor_role text; student_user integer;
BEGIN
  IF TG_OP='UPDATE' AND (NEW."StudentID",NEW."CurriculumID",NEW."SourceComboID") IS DISTINCT FROM (OLD."StudentID",OLD."CurriculumID",OLD."SourceComboID") THEN
    RAISE EXCEPTION 'Cancel the old selection and register a new combo instead of changing identity keys';
  END IF;
  SELECT "ComboType" INTO actual_type FROM public."CurriculumCombos"
    WHERE "CurriculumID"=NEW."CurriculumID" AND "SourceComboID"=NEW."SourceComboID";
  IF actual_type IS NULL THEN RAISE EXCEPTION 'Combo does not belong to curriculum'; END IF;
  NEW."ComboType" := actual_type;
  SELECT "UserID" INTO student_user FROM public."Students" WHERE "StudentID"=NEW."StudentID";
  SELECT r."RoleCode" INTO actor_role FROM public."Users" u JOIN public."Roles" r USING ("RoleID")
    WHERE u."UserID"=NEW."LastChangedBy" AND u."Status"='ACTIVE';
  IF actor_role IS NULL OR actor_role NOT IN ('STUDENT','ACADEMIC','ADMIN') OR (actor_role='STUDENT' AND student_user IS DISTINCT FROM NEW."LastChangedBy") THEN
    RAISE EXCEPTION 'Combo actor must be the student, academic staff or admin';
  END IF;
  SELECT * INTO w FROM public."ComboRegistrationWindows" WHERE "WindowID"=NEW."RegistrationWindowID" FOR SHARE;
  IF NOT FOUND THEN RAISE EXCEPTION 'A registration window is required'; END IF;
  IF w."CurriculumID"<>NEW."CurriculumID" OR w."ComboType"<>actual_type THEN
    RAISE EXCEPTION 'Registration window does not apply to this curriculum and combo type';
  END IF;
  IF w."Status"<>'OPEN' OR clock_timestamp()<w."OpensAt" OR clock_timestamp()>=w."ClosesAt" THEN
    RAISE EXCEPTION 'Combo registration window is not open';
  END IF;
  IF TG_OP='UPDATE' AND NOT w."AllowChanges" THEN RAISE EXCEPTION 'Changes are not allowed in this window'; END IF;
  NEW."ChangedAt" := clock_timestamp();
  RETURN NEW;
END $f$;
DROP TRIGGER IF EXISTS "TR_StudentComboSelections_Registration" ON public."StudentComboSelections";
CREATE TRIGGER "TR_StudentComboSelections_Registration" BEFORE INSERT OR UPDATE ON public."StudentComboSelections"
FOR EACH ROW EXECUTE FUNCTION public."validate_combo_registration"();

CREATE OR REPLACE FUNCTION public."audit_combo_registration"() RETURNS trigger
LANGUAGE plpgsql SET search_path=public AS $f$
BEGIN
  INSERT INTO public."StudentComboSelectionEvents" ("SelectionID","WindowID","EventType","ActorUserID","PreviousState","NewState")
  VALUES (NEW."SelectionID",NEW."RegistrationWindowID",CASE WHEN NEW."Status"='CANCELLED' THEN 'CANCELLED' WHEN TG_OP='INSERT' THEN 'REGISTERED' ELSE 'UPDATED' END,
    NEW."LastChangedBy",CASE WHEN TG_OP='UPDATE' THEN to_jsonb(OLD) ELSE NULL END,to_jsonb(NEW));
  RETURN NEW;
END $f$;
DROP TRIGGER IF EXISTS "TR_StudentComboSelections_Audit" ON public."StudentComboSelections";
CREATE TRIGGER "TR_StudentComboSelections_Audit" AFTER INSERT OR UPDATE ON public."StudentComboSelections"
FOR EACH ROW EXECUTE FUNCTION public."audit_combo_registration"();

-- Backend xác minh JWT/quyền trước khi gọi. Function SECURITY INVOKER, chỉ service_role được gọi.
CREATE OR REPLACE FUNCTION public."RegisterStudentCombo"(p_student integer,p_curriculum bigint,p_combo bigint,p_window bigint,p_actor integer)
RETURNS bigint LANGUAGE plpgsql SET search_path=public AS $f$
DECLARE result_id bigint; type_name text; actor_role text; owner_id integer; w public."ComboRegistrationWindows"%ROWTYPE;
BEGIN
  PERFORM 1 FROM public."Students" WHERE "StudentID"=p_student FOR UPDATE;
  IF NOT FOUND THEN RAISE EXCEPTION 'Student not found'; END IF;
  SELECT "UserID" INTO owner_id FROM public."Students" WHERE "StudentID"=p_student;
  SELECT r."RoleCode" INTO actor_role FROM public."Users" u JOIN public."Roles" r USING ("RoleID") WHERE u."UserID"=p_actor AND u."Status"='ACTIVE';
  IF actor_role IS NULL OR actor_role NOT IN ('STUDENT','ACADEMIC','ADMIN') OR (actor_role='STUDENT' AND owner_id IS DISTINCT FROM p_actor) THEN RAISE EXCEPTION 'Unauthorized combo actor'; END IF;
  SELECT "ComboType" INTO type_name FROM public."CurriculumCombos" WHERE "CurriculumID"=p_curriculum AND "SourceComboID"=p_combo;
  IF type_name IS NULL THEN RAISE EXCEPTION 'Combo not found'; END IF;
  SELECT * INTO w FROM public."ComboRegistrationWindows" WHERE "WindowID"=p_window FOR SHARE;
  IF NOT FOUND OR w."CurriculumID"<>p_curriculum OR w."ComboType"<>type_name OR w."Status"<>'OPEN' OR clock_timestamp()<w."OpensAt" OR clock_timestamp()>=w."ClosesAt" THEN
    RAISE EXCEPTION 'Registration window is not available';
  END IF;
  -- Cùng lựa chọn: không ghi lại hoặc đòi quyền đổi khi AllowChanges=false.
  SELECT "SelectionID" INTO result_id FROM public."StudentComboSelections" WHERE "StudentID"=p_student AND "CurriculumID"=p_curriculum AND "SourceComboID"=p_combo AND "Status"='ACTIVE';
  IF result_id IS NOT NULL THEN RETURN result_id; END IF;
  UPDATE public."StudentComboSelections" SET "Status"='CANCELLED',"LastChangedBy"=p_actor,"RegistrationWindowID"=p_window
    WHERE "StudentID"=p_student AND "ComboType"=type_name AND "Status"='ACTIVE';
  INSERT INTO public."StudentComboSelections" ("StudentID","CurriculumID","SourceComboID","RegistrationWindowID","Status","LastChangedBy")
  VALUES (p_student,p_curriculum,p_combo,p_window,'ACTIVE',p_actor)
  ON CONFLICT ("StudentID","CurriculumID","SourceComboID") DO UPDATE
    SET "RegistrationWindowID"=EXCLUDED."RegistrationWindowID","Status"='ACTIVE',"LastChangedBy"=EXCLUDED."LastChangedBy"
  RETURNING "SelectionID" INTO result_id;
  RETURN result_id;
END $f$;
