-- ============================================
-- 5. KIỂM TRA
-- ============================================

SELECT
    u.UserID,
    u.Username,
    u.Email,
    u.FullName,
    r.RoleCode,
    r.RoleName,
    u.Status
FROM Users u
JOIN Roles r ON r.RoleID = u.RoleID
ORDER BY u.UserID;