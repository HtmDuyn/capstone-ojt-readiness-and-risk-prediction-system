-- 6. Existing calendar/demo seed. Dates remain relative to execution time.
CREATE TEMP TABLE _demo_study_periods(stage int PRIMARY KEY, period_id int NOT NULL) ON COMMIT DROP;
DO $calendar$
DECLARE target date; start_day date; end_day date; y int; calendar_year int; month_no int; stage int; season text;
BEGIN
 target := (date_trunc('year',current_date)+(4*((extract(month FROM current_date)::int-1)/4+1))*interval '1 month')::date;
 -- Build complete years first, including the unused semesters at both boundaries.
 FOR calendar_year IN extract(year FROM target-interval '24 months')::int..extract(year FROM target+interval '12 months')::int LOOP
  INSERT INTO "AcademicYears" ("YearCode","StartDate","EndDate","Status")
  VALUES(calendar_year||'-'||(calendar_year+1),make_date(calendar_year,1,1),make_date(calendar_year,12,31),
   CASE WHEN calendar_year<extract(year FROM current_date) THEN 'CLOSED' WHEN calendar_year=extract(year FROM current_date) THEN 'ACTIVE' ELSE 'PLANNED' END)
  RETURNING "AcademicYearID" INTO y;
  FOREACH month_no IN ARRAY ARRAY[1,5,9] LOOP
   start_day := make_date(calendar_year,month_no,1);
   end_day := (start_day+interval '4 months'-interval '1 day')::date;
   season := CASE month_no WHEN 1 THEN 'SPRING' WHEN 5 THEN 'SUMMER' ELSE 'FALL' END;
   INSERT INTO "AcademicPeriods" ("AcademicYearID","PeriodCode","Name","Kind","StartDate","EndDate","Status")
   VALUES(y,season||calendar_year,initcap(season)||' '||calendar_year,'SEMESTER',start_day,end_day,
    CASE WHEN end_day<current_date THEN 'CLOSED' WHEN start_day<=current_date THEN 'ACTIVE' ELSE 'PLANNED' END);
  END LOOP;
 END LOOP;
 -- Curriculum stage is a separate mapping, never a count of calendar rows.
 FOR stage IN 0..9 LOOP
  start_day := (target+(stage-6)*interval '4 months')::date;
  INSERT INTO _demo_study_periods
  SELECT stage,"AcademicPeriodID" FROM "AcademicPeriods" WHERE "Kind"='SEMESTER' AND "StartDate"=start_day;
 END LOOP;
 INSERT INTO "OJTSemesters" ("AcademicYearID","AcademicPeriodID","SemesterCode","Name","RegStartDate","RegEndDate","StartDate","EndDate","Status")
 SELECT p."AcademicYearID",p."AcademicPeriodID",'DEMO-OJT-S6','OJT kỳ chương trình 6 - '||p."Name",current_date,least(current_date+21,target-1),p."StartDate",p."EndDate",'PLANNED'
 FROM _demo_study_periods m JOIN "AcademicPeriods" p ON p."AcademicPeriodID"=m.period_id WHERE m.stage=6;
END $calendar$;


