/*
============================================================
1. USER & ACCESS MANAGEMENT
============================================================
*/

CREATE TABLE Roles (
    RoleID INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    RoleCode VARCHAR(30) NOT NULL UNIQUE,
    RoleName VARCHAR(100) NOT NULL,

    CONSTRAINT CHK_Roles_RoleCode
        CHECK (length(trim(RoleCode)) > 0),

    CONSTRAINT CHK_Roles_RoleName
        CHECK (length(trim(RoleName)) > 0)
);


CREATE TABLE Permissions (
    PermissionID INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    PermissionCode VARCHAR(50) NOT NULL UNIQUE,
    PermissionName VARCHAR(150) NOT NULL,
    Description VARCHAR(300),

    CONSTRAINT CHK_Permissions_Code
        CHECK (length(trim(PermissionCode)) > 0),

    CONSTRAINT CHK_Permissions_Name
        CHECK (length(trim(PermissionName)) > 0)
);


CREATE TABLE RolePermissions (
    RolePermissionID INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    RoleID INT NOT NULL,
    PermissionID INT NOT NULL,

    CONSTRAINT UQ_RolePermissions
        UNIQUE (RoleID, PermissionID),

    CONSTRAINT FK_RolePermissions_Role
        FOREIGN KEY (RoleID)
        REFERENCES Roles(RoleID)
        ON DELETE CASCADE,

    CONSTRAINT FK_RolePermissions_Permission
        FOREIGN KEY (PermissionID)
        REFERENCES Permissions(PermissionID)
        ON DELETE CASCADE
);


CREATE TABLE Users (
    UserID INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    Username VARCHAR(50) NOT NULL UNIQUE,
    PasswordHash VARCHAR(255) NOT NULL,
    Email VARCHAR(100) NOT NULL UNIQUE,
    Phone VARCHAR(20),
    FullName VARCHAR(150) NOT NULL,

    RoleID INT NOT NULL,

    Status VARCHAR(20) NOT NULL DEFAULT 'ACTIVE',

    CreatedAt TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UpdatedAt TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    LastLoginAt TIMESTAMPTZ,

    CONSTRAINT FK_Users_Role
        FOREIGN KEY (RoleID)
        REFERENCES Roles(RoleID)
        ON DELETE RESTRICT,

    CONSTRAINT CHK_Users_Status
        CHECK (Status IN ('ACTIVE', 'INACTIVE', 'LOCKED')),

    CONSTRAINT CHK_Users_Email
        CHECK (position('@' IN Email) > 1),

    CONSTRAINT CHK_Users_FullName
        CHECK (length(trim(FullName)) > 0)
);


/*
============================================================
2. ACADEMIC MANAGEMENT
============================================================
*/

CREATE TABLE AcademicYears (
    AcademicYearID INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    YearCode VARCHAR(20) NOT NULL UNIQUE,
    StartDate DATE,
    EndDate DATE,
    Status VARCHAR(20),

    CONSTRAINT CHK_AcademicYears_Date
        CHECK (
            StartDate IS NULL
            OR EndDate IS NULL
            OR StartDate <= EndDate
        ),

    CONSTRAINT CHK_AcademicYears_Status
        CHECK (
            Status IS NULL
            OR Status IN ('PLANNING', 'ACTIVE', 'COMPLETED', 'CANCELLED')
        )
);


CREATE TABLE OJTSemesters (
    OJTSemesterID INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    AcademicYearID INT NOT NULL,
    SemesterCode VARCHAR(20) NOT NULL UNIQUE,
    Name VARCHAR(100) NOT NULL,

    RegStartDate DATE,
    RegEndDate DATE,

    StartDate DATE,
    EndDate DATE,

    Status VARCHAR(30),

    CONSTRAINT FK_OJTSemesters_AcademicYear
        FOREIGN KEY (AcademicYearID)
        REFERENCES AcademicYears(AcademicYearID)
        ON DELETE RESTRICT,

    CONSTRAINT CHK_OJTSemesters_RegDate
        CHECK (
            RegStartDate IS NULL
            OR RegEndDate IS NULL
            OR RegStartDate <= RegEndDate
        ),

    CONSTRAINT CHK_OJTSemesters_Date
        CHECK (
            StartDate IS NULL
            OR EndDate IS NULL
            OR StartDate <= EndDate
        ),

    CONSTRAINT CHK_OJTSemesters_Status
        CHECK (
            Status IS NULL
            OR Status IN (
                'PLANNING',
                'OPEN',
                'REGISTRATION',
                'ONGOING',
                'COMPLETED',
                'CANCELLED'
            )
        )
);


CREATE TABLE TrainingPrograms (
    ProgramID INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    ProgramCode VARCHAR(20) NOT NULL UNIQUE,
    ProgramName VARCHAR(150) NOT NULL,

    Specialty VARCHAR(10),
    TotalCredits INT,

    Version VARCHAR(10),
    EffectiveYear INT,

    CONSTRAINT CHK_TrainingPrograms_Credits
        CHECK (
            TotalCredits IS NULL
            OR TotalCredits > 0
        ),

    CONSTRAINT CHK_TrainingPrograms_Year
        CHECK (
            EffectiveYear IS NULL
            OR EffectiveYear BETWEEN 2000 AND 2100
        )
);


CREATE TABLE Courses (
    CourseID INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    CourseCode VARCHAR(20) NOT NULL UNIQUE,
    CourseName VARCHAR(150) NOT NULL,

    Credits INT,

    IsOJTPrerequisite BOOLEAN NOT NULL DEFAULT FALSE,

    CONSTRAINT CHK_Courses_Credits
        CHECK (
            Credits IS NULL
            OR Credits > 0
        )
);


CREATE TABLE CoursePrerequisites (
    CourseID INT NOT NULL,
    PrerequisiteCourseID INT NOT NULL,

    CONSTRAINT PK_CoursePrerequisites
        PRIMARY KEY (CourseID, PrerequisiteCourseID),

    CONSTRAINT FK_CoursePrerequisites_Course
        FOREIGN KEY (CourseID)
        REFERENCES Courses(CourseID)
        ON DELETE CASCADE,

    CONSTRAINT FK_CoursePrerequisites_Prerequisite
        FOREIGN KEY (PrerequisiteCourseID)
        REFERENCES Courses(CourseID)
        ON DELETE RESTRICT,

    CONSTRAINT CHK_CoursePrerequisites_Self
        CHECK (CourseID <> PrerequisiteCourseID)
);


CREATE TABLE ProgramCourses (
    ProgramCourseID INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    ProgramID INT NOT NULL,
    CourseID INT NOT NULL,

    RecommendedSemester INT,

    IsRequired BOOLEAN NOT NULL DEFAULT TRUE,

    CONSTRAINT UQ_ProgramCourses
        UNIQUE (ProgramID, CourseID),

    CONSTRAINT FK_ProgramCourses_Program
        FOREIGN KEY (ProgramID)
        REFERENCES TrainingPrograms(ProgramID)
        ON DELETE CASCADE,

    CONSTRAINT FK_ProgramCourses_Course
        FOREIGN KEY (CourseID)
        REFERENCES Courses(CourseID)
        ON DELETE CASCADE,

    CONSTRAINT CHK_ProgramCourses_Semester
        CHECK (
            RecommendedSemester IS NULL
            OR RecommendedSemester > 0
        )
);


CREATE TABLE Students (
    StudentID INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    UserID INT NOT NULL UNIQUE,
    StudentCode VARCHAR(20) NOT NULL UNIQUE,

    ProgramID INT,
    Specialty VARCHAR(10),

    EnrollmentYear INT,
    CurrentSemester INT,

    ClassName VARCHAR(20),
    Status VARCHAR(30),

    CONSTRAINT FK_Students_User
        FOREIGN KEY (UserID)
        REFERENCES Users(UserID)
        ON DELETE CASCADE,

    CONSTRAINT FK_Students_Program
        FOREIGN KEY (ProgramID)
        REFERENCES TrainingPrograms(ProgramID)
        ON DELETE SET NULL,

    CONSTRAINT CHK_Students_EnrollmentYear
        CHECK (
            EnrollmentYear IS NULL
            OR EnrollmentYear BETWEEN 2000 AND 2100
        ),

    CONSTRAINT CHK_Students_Semester
        CHECK (
            CurrentSemester IS NULL
            OR CurrentSemester > 0
        ),

    CONSTRAINT CHK_Students_Status
        CHECK (
            Status IS NULL
            OR Status IN (
                'ACTIVE',
                'INACTIVE',
                'GRADUATED',
                'SUSPENDED',
                'DROPPED'
            )
        )
);


CREATE TABLE StudentCourseResults (
    ResultID INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    StudentID INT NOT NULL,
    CourseID INT NOT NULL,

    SemesterTaken INT,
    AcademicYearID INT,

    Score DECIMAL(4,2),
    Grade VARCHAR(2),
    Status VARCHAR(20),

    CONSTRAINT UQ_StudentCourseResults
        UNIQUE (StudentID, CourseID, SemesterTaken),

    CONSTRAINT FK_StudentCourseResults_Student
        FOREIGN KEY (StudentID)
        REFERENCES Students(StudentID)
        ON DELETE CASCADE,

    CONSTRAINT FK_StudentCourseResults_Course
        FOREIGN KEY (CourseID)
        REFERENCES Courses(CourseID)
        ON DELETE RESTRICT,

    CONSTRAINT FK_StudentCourseResults_AcademicYear
        FOREIGN KEY (AcademicYearID)
        REFERENCES AcademicYears(AcademicYearID)
        ON DELETE SET NULL,

    CONSTRAINT CHK_StudentCourseResults_Semester
        CHECK (
            SemesterTaken IS NULL
            OR SemesterTaken > 0
        ),

    CONSTRAINT CHK_StudentCourseResults_Score
        CHECK (
            Score IS NULL
            OR (
                Score >= 0
                AND Score <= 10
            )
        ),

    CONSTRAINT CHK_StudentCourseResults_Status
        CHECK (
            Status IS NULL
            OR Status IN ('PASSED', 'FAILED', 'IN_PROGRESS', 'EXEMPTED')
        )
);


CREATE TABLE StudentAcademicSnapshot (
    SnapshotID INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    StudentID INT NOT NULL,
    SnapshotDate DATE NOT NULL,

    GPA DECIMAL(3,2),
    AccumulatedCredits INT,
    RemainingCredits INT,
    FailedCoursesCount INT,
    CurrentSemester INT,

    TargetOJTSemesterID INT,

    CONSTRAINT FK_StudentAcademicSnapshot_Student
        FOREIGN KEY (StudentID)
        REFERENCES Students(StudentID)
        ON DELETE CASCADE,

    CONSTRAINT FK_StudentAcademicSnapshot_Semester
        FOREIGN KEY (TargetOJTSemesterID)
        REFERENCES OJTSemesters(OJTSemesterID)
        ON DELETE SET NULL,

    CONSTRAINT CHK_Snapshot_GPA
        CHECK (
            GPA IS NULL
            OR (
                GPA >= 0
                AND GPA <= 4
            )
        ),

    CONSTRAINT CHK_Snapshot_Credits
        CHECK (
            (AccumulatedCredits IS NULL OR AccumulatedCredits >= 0)
            AND
            (RemainingCredits IS NULL OR RemainingCredits >= 0)
        ),

    CONSTRAINT CHK_Snapshot_FailedCourses
        CHECK (
            FailedCoursesCount IS NULL
            OR FailedCoursesCount >= 0
        ),

    CONSTRAINT CHK_Snapshot_Semester
        CHECK (
            CurrentSemester IS NULL
            OR CurrentSemester > 0
        )
);


/*
============================================================
3. OJT ELIGIBILITY
============================================================
*/

CREATE TABLE OJTEligibilityConditions (
    ConditionID INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    ProgramID INT NOT NULL,
    OJTSemesterID INT,

    MinGPA DECIMAL(3,2),
    MinCredits INT,

    RequiredCoursesNote VARCHAR(500),
    Description VARCHAR(500),

    CONSTRAINT FK_OJTEligibilityConditions_Program
        FOREIGN KEY (ProgramID)
        REFERENCES TrainingPrograms(ProgramID)
        ON DELETE CASCADE,

    CONSTRAINT FK_OJTEligibilityConditions_Semester
        FOREIGN KEY (OJTSemesterID)
        REFERENCES OJTSemesters(OJTSemesterID)
        ON DELETE SET NULL,

    CONSTRAINT CHK_Eligibility_MinGPA
        CHECK (
            MinGPA IS NULL
            OR (
                MinGPA >= 0
                AND MinGPA <= 4
            )
        ),

    CONSTRAINT CHK_Eligibility_MinCredits
        CHECK (
            MinCredits IS NULL
            OR MinCredits >= 0
        )
);


CREATE TABLE StudentOJTEligibility (
    EligibilityID INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    StudentID INT NOT NULL,
    OJTSemesterID INT NOT NULL,

    Status VARCHAR(30) NOT NULL,

    CheckedDate TIMESTAMPTZ,
    CheckedBy INT,

    MissingCredits INT,
    MissingCoursesNote VARCHAR(1000),

    CONSTRAINT UQ_StudentOJTEligibility
        UNIQUE (StudentID, OJTSemesterID),

    CONSTRAINT FK_StudentOJTEligibility_Student
        FOREIGN KEY (StudentID)
        REFERENCES Students(StudentID)
        ON DELETE CASCADE,

    CONSTRAINT FK_StudentOJTEligibility_Semester
        FOREIGN KEY (OJTSemesterID)
        REFERENCES OJTSemesters(OJTSemesterID)
        ON DELETE RESTRICT,

    CONSTRAINT FK_StudentOJTEligibility_CheckedBy
        FOREIGN KEY (CheckedBy)
        REFERENCES Users(UserID)
        ON DELETE SET NULL,

    CONSTRAINT CHK_StudentOJTEligibility_Status
        CHECK (
            Status IN (
                'ELIGIBLE',
                'NOT_ELIGIBLE',
                'PENDING',
                'RECHECK_REQUIRED'
            )
        ),

    CONSTRAINT CHK_StudentOJTEligibility_MissingCredits
        CHECK (
            MissingCredits IS NULL
            OR MissingCredits >= 0
        )
);


/*
============================================================
4. AI RISK PREDICTION & PATHWAY
============================================================
*/

CREATE TABLE AIModels (
    ModelID INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    ModelCode VARCHAR(30) NOT NULL UNIQUE,
    ModelName VARCHAR(100) NOT NULL,

    ModelType VARCHAR(30),
    Algorithm VARCHAR(50),
    Version VARCHAR(20),

    TrainedDate DATE,

    IsActive BOOLEAN NOT NULL DEFAULT FALSE,

    MetricsJSON JSONB NOT NULL DEFAULT '{}'::jsonb,
    ArtifactPath VARCHAR(255),

    CONSTRAINT CHK_AIModels_MetricsObject
        CHECK (jsonb_typeof(MetricsJSON) = 'object'),

    CONSTRAINT CHK_AIModels_ActiveVersion
        CHECK (length(trim(Version)) > 0)
);


CREATE TABLE AIModelConfig (
    ConfigID INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    ModelID INT NOT NULL,

    RiskThresholdMedium DECIMAL(4,3),
    RiskThresholdHigh DECIMAL(4,3),

    UpdatedBy INT,

    UpdatedAt TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT FK_AIModelConfig_Model
        FOREIGN KEY (ModelID)
        REFERENCES AIModels(ModelID)
        ON DELETE CASCADE,

    CONSTRAINT FK_AIModelConfig_UpdatedBy
        FOREIGN KEY (UpdatedBy)
        REFERENCES Users(UserID)
        ON DELETE SET NULL,

    CONSTRAINT CHK_AIModelConfig_Threshold
        CHECK (
            RiskThresholdMedium >= 0
            AND RiskThresholdMedium <= 1
            AND RiskThresholdHigh >= 0
            AND RiskThresholdHigh <= 1
            AND RiskThresholdMedium <= RiskThresholdHigh
        )
);


CREATE TABLE RiskPredictions (
    PredictionID INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    StudentID INT NOT NULL,
    OJTSemesterID INT NOT NULL,
    ModelID INT NOT NULL,
    SnapshotID INT NOT NULL,

    RiskProbability DECIMAL(5,4),
    RiskLevel VARCHAR(10),

    PredictedAt TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    FeaturesJSON JSONB NOT NULL DEFAULT '{}'::jsonb,

    CONSTRAINT FK_RiskPredictions_Student
        FOREIGN KEY (StudentID)
        REFERENCES Students(StudentID)
        ON DELETE CASCADE,

    CONSTRAINT FK_RiskPredictions_OJTSemester
        FOREIGN KEY (OJTSemesterID)
        REFERENCES OJTSemesters(OJTSemesterID)
        ON DELETE RESTRICT,

    CONSTRAINT FK_RiskPredictions_Model
        FOREIGN KEY (ModelID)
        REFERENCES AIModels(ModelID)
        ON DELETE RESTRICT,

    CONSTRAINT FK_RiskPredictions_Snapshot
        FOREIGN KEY (SnapshotID)
        REFERENCES StudentAcademicSnapshot(SnapshotID)
        ON DELETE RESTRICT,

    CONSTRAINT CHK_RiskPredictions_Probability
        CHECK (
            RiskProbability IS NULL
            OR (
                RiskProbability >= 0
                AND RiskProbability <= 1
            )
        ),

    CONSTRAINT CHK_RiskPredictions_Level
        CHECK (
            RiskLevel IS NULL
            OR RiskLevel IN ('LOW', 'MEDIUM', 'HIGH')
        ),

    CONSTRAINT CHK_RiskPredictions_FeaturesObject
        CHECK (jsonb_typeof(FeaturesJSON) = 'object')
);


CREATE TABLE PathwayRecommendations (
    RecommendationID INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    StudentID INT NOT NULL,
    PredictionID INT,

    OJTSemesterID INT NOT NULL,

    MissingCourses VARCHAR(1000),
    RecommendedPlan TEXT,

    GeneratedAt TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    Status VARCHAR(20),

    CONSTRAINT FK_PathwayRecommendations_Student
        FOREIGN KEY (StudentID)
        REFERENCES Students(StudentID)
        ON DELETE CASCADE,

    CONSTRAINT FK_PathwayRecommendations_Prediction
        FOREIGN KEY (PredictionID)
        REFERENCES RiskPredictions(PredictionID)
        ON DELETE SET NULL,

    CONSTRAINT FK_PathwayRecommendations_Semester
        FOREIGN KEY (OJTSemesterID)
        REFERENCES OJTSemesters(OJTSemesterID)
        ON DELETE RESTRICT,

    CONSTRAINT CHK_PathwayRecommendations_Status
        CHECK (
            Status IS NULL
            OR Status IN (
                'GENERATED',
                'VIEWED',
                'ACCEPTED',
                'DISMISSED'
            )
        )
);


CREATE TABLE SupportClassAISuggestions (
    SuggestionID INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    CourseID INT NOT NULL,
    OJTSemesterID INT NOT NULL,

    SuggestedStudentCount INT,
    Reason VARCHAR(500),

    SuggestedAt TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    Status VARCHAR(20),

    CONSTRAINT FK_SupportClassAISuggestions_Course
        FOREIGN KEY (CourseID)
        REFERENCES Courses(CourseID)
        ON DELETE RESTRICT,

    CONSTRAINT FK_SupportClassAISuggestions_Semester
        FOREIGN KEY (OJTSemesterID)
        REFERENCES OJTSemesters(OJTSemesterID)
        ON DELETE RESTRICT,

    CONSTRAINT CHK_SupportClassAISuggestions_Count
        CHECK (
            SuggestedStudentCount IS NULL
            OR SuggestedStudentCount >= 0
        ),

    CONSTRAINT CHK_SupportClassAISuggestions_Status
        CHECK (
            Status IS NULL
            OR Status IN (
                'PENDING',
                'APPROVED',
                'REJECTED',
                'USED'
            )
        )
);


/*
============================================================
5. SUPPORT CLASS
============================================================
*/

CREATE TABLE SupportClasses (
    SupportClassID INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    CourseID INT NOT NULL,
    OJTSemesterID INT NOT NULL,

    ClassName VARCHAR(100),

    SuggestionID INT,

    StartDate DATE,
    EndDate DATE,

    Capacity INT,

    CreatedBy INT,

    Status VARCHAR(20),

    CONSTRAINT FK_SupportClasses_Course
        FOREIGN KEY (CourseID)
        REFERENCES Courses(CourseID)
        ON DELETE RESTRICT,

    CONSTRAINT FK_SupportClasses_Semester
        FOREIGN KEY (OJTSemesterID)
        REFERENCES OJTSemesters(OJTSemesterID)
        ON DELETE RESTRICT,

    CONSTRAINT FK_SupportClasses_Suggestion
        FOREIGN KEY (SuggestionID)
        REFERENCES SupportClassAISuggestions(SuggestionID)
        ON DELETE SET NULL,

    CONSTRAINT FK_SupportClasses_CreatedBy
        FOREIGN KEY (CreatedBy)
        REFERENCES Users(UserID)
        ON DELETE SET NULL,

    CONSTRAINT CHK_SupportClasses_Date
        CHECK (
            StartDate IS NULL
            OR EndDate IS NULL
            OR StartDate <= EndDate
        ),

    CONSTRAINT CHK_SupportClasses_Capacity
        CHECK (
            Capacity IS NULL
            OR Capacity > 0
        ),

    CONSTRAINT CHK_SupportClasses_Status
        CHECK (
            Status IS NULL
            OR Status IN (
                'PLANNING',
                'OPEN',
                'FULL',
                'ONGOING',
                'COMPLETED',
                'CANCELLED'
            )
        )
);


CREATE TABLE SupportClassRegistrations (
    RegistrationID INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    SupportClassID INT NOT NULL,
    StudentID INT NOT NULL,

    RegisteredDate TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    Status VARCHAR(20),

    CONSTRAINT UQ_SupportClassStudent
        UNIQUE (SupportClassID, StudentID),

    CONSTRAINT FK_SupportClassRegistrations_Class
        FOREIGN KEY (SupportClassID)
        REFERENCES SupportClasses(SupportClassID)
        ON DELETE CASCADE,

    CONSTRAINT FK_SupportClassRegistrations_Student
        FOREIGN KEY (StudentID)
        REFERENCES Students(StudentID)
        ON DELETE CASCADE,

    CONSTRAINT CHK_SupportClassRegistrations_Status
        CHECK (
            Status IS NULL
            OR Status IN ('REGISTERED', 'COMPLETED', 'CANCELLED')
        )
);


/*
============================================================
6. ENTERPRISE & OJT REGISTRATION
============================================================
*/

CREATE TABLE Enterprises (
    EnterpriseID INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    EnterpriseCode VARCHAR(20) NOT NULL UNIQUE,
    Name VARCHAR(200) NOT NULL,

    Address VARCHAR(300),
    Industry VARCHAR(100),

    ContactPersonName VARCHAR(100),
    ContactPhone VARCHAR(20),
    ContactEmail VARCHAR(100),

    Status VARCHAR(20),

    CreatedAt TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT CHK_Enterprises_Status
        CHECK (
            Status IS NULL
            OR Status IN ('ACTIVE', 'INACTIVE', 'SUSPENDED')
        )
);


CREATE TABLE EnterpriseUsers (
    EnterpriseUserID INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    UserID INT NOT NULL UNIQUE,
    EnterpriseID INT NOT NULL,

    PositionTitle VARCHAR(100),

    CONSTRAINT FK_EnterpriseUsers_User
        FOREIGN KEY (UserID)
        REFERENCES Users(UserID)
        ON DELETE CASCADE,

    CONSTRAINT FK_EnterpriseUsers_Enterprise
        FOREIGN KEY (EnterpriseID)
        REFERENCES Enterprises(EnterpriseID)
        ON DELETE CASCADE
);


CREATE TABLE InternshipPositions (
    PositionID INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    EnterpriseID INT NOT NULL,
    OJTSemesterID INT NOT NULL,

    Title VARCHAR(150) NOT NULL,

    Description TEXT,
    Requirements TEXT,

    Capacity INT,
    RemainingSlots INT,

    Status VARCHAR(20),

    CONSTRAINT FK_InternshipPositions_Enterprise
        FOREIGN KEY (EnterpriseID)
        REFERENCES Enterprises(EnterpriseID)
        ON DELETE CASCADE,

    CONSTRAINT FK_InternshipPositions_Semester
        FOREIGN KEY (OJTSemesterID)
        REFERENCES OJTSemesters(OJTSemesterID)
        ON DELETE RESTRICT,

    CONSTRAINT CHK_InternshipPositions_Capacity
        CHECK (
            Capacity IS NULL
            OR Capacity > 0
        ),

    CONSTRAINT CHK_InternshipPositions_Remaining
        CHECK (
            RemainingSlots IS NULL
            OR RemainingSlots >= 0
        ),

    CONSTRAINT CHK_InternshipPositions_CapacityRelation
        CHECK (
            Capacity IS NULL
            OR RemainingSlots IS NULL
            OR RemainingSlots <= Capacity
        ),

    CONSTRAINT CHK_InternshipPositions_Status
        CHECK (
            Status IS NULL
            OR Status IN (
                'OPEN',
                'FULL',
                'CLOSED',
                'CANCELLED'
            )
        )
);


CREATE TABLE OJTRegistrations (
    RegistrationID INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    StudentID INT NOT NULL,
    OJTSemesterID INT NOT NULL,

    RegisteredAt TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    PreferredPositionID INT,

    Status VARCHAR(30),

    CONSTRAINT UQ_OJTRegistration
        UNIQUE (StudentID, OJTSemesterID),

    CONSTRAINT FK_OJTRegistrations_Student
        FOREIGN KEY (StudentID)
        REFERENCES Students(StudentID)
        ON DELETE CASCADE,

    CONSTRAINT FK_OJTRegistrations_Semester
        FOREIGN KEY (OJTSemesterID)
        REFERENCES OJTSemesters(OJTSemesterID)
        ON DELETE RESTRICT,

    CONSTRAINT FK_OJTRegistrations_Position
        FOREIGN KEY (PreferredPositionID)
        REFERENCES InternshipPositions(PositionID)
        ON DELETE SET NULL,

    CONSTRAINT CHK_OJTRegistrations_Status
        CHECK (
            Status IS NULL
            OR Status IN (
                'DRAFT',
                'SUBMITTED',
                'PROCESSING',
                'APPROVED',
                'REJECTED',
                'CANCELLED'
            )
        )
);


CREATE TABLE StudentEnterpriseCoordination (
    CoordinationID INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    RegistrationID INT NOT NULL,
    EnterpriseID INT NOT NULL,
    PositionID INT NOT NULL,

    CoordinatedBy INT NOT NULL,

    CoordinatedAt TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    Decision VARCHAR(20),
    DecisionAt TIMESTAMPTZ,

    RejectReason VARCHAR(300),

    PreviousCoordinationID INT,

    CONSTRAINT FK_StudentEnterpriseCoordination_Registration
        FOREIGN KEY (RegistrationID)
        REFERENCES OJTRegistrations(RegistrationID)
        ON DELETE CASCADE,

    CONSTRAINT FK_StudentEnterpriseCoordination_Enterprise
        FOREIGN KEY (EnterpriseID)
        REFERENCES Enterprises(EnterpriseID)
        ON DELETE RESTRICT,

    CONSTRAINT FK_StudentEnterpriseCoordination_Position
        FOREIGN KEY (PositionID)
        REFERENCES InternshipPositions(PositionID)
        ON DELETE RESTRICT,

    CONSTRAINT FK_StudentEnterpriseCoordination_User
        FOREIGN KEY (CoordinatedBy)
        REFERENCES Users(UserID)
        ON DELETE RESTRICT,

    CONSTRAINT FK_StudentEnterpriseCoordination_Previous
        FOREIGN KEY (PreviousCoordinationID)
        REFERENCES StudentEnterpriseCoordination(CoordinationID)
        ON DELETE SET NULL,

    CONSTRAINT CHK_Coordination_Decision
        CHECK (
            Decision IS NULL
            OR Decision IN ('PENDING', 'ACCEPTED', 'REJECTED')
        ),

    CONSTRAINT CHK_Coordination_DecisionDate
        CHECK (
            Decision IS NULL
            OR DecisionAt IS NOT NULL
        )
);


/*
============================================================
7. INTERNSHIP MANAGEMENT
============================================================
*/

CREATE TABLE InternshipAssignments (
    AssignmentID INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    CoordinationID INT NOT NULL UNIQUE,

    StudentID INT NOT NULL,
    EnterpriseID INT NOT NULL,
    PositionID INT NOT NULL,

    EnterpriseSupervisorName VARCHAR(100),

    StartDate DATE,
    EndDate DATE,

    Status VARCHAR(20),

    CONSTRAINT FK_InternshipAssignments_Coordination
        FOREIGN KEY (CoordinationID)
        REFERENCES StudentEnterpriseCoordination(CoordinationID)
        ON DELETE RESTRICT,

    CONSTRAINT FK_InternshipAssignments_Student
        FOREIGN KEY (StudentID)
        REFERENCES Students(StudentID)
        ON DELETE RESTRICT,

    CONSTRAINT FK_InternshipAssignments_Enterprise
        FOREIGN KEY (EnterpriseID)
        REFERENCES Enterprises(EnterpriseID)
        ON DELETE RESTRICT,

    CONSTRAINT FK_InternshipAssignments_Position
        FOREIGN KEY (PositionID)
        REFERENCES InternshipPositions(PositionID)
        ON DELETE RESTRICT,

    CONSTRAINT CHK_InternshipAssignments_Date
        CHECK (
            StartDate IS NULL
            OR EndDate IS NULL
            OR StartDate <= EndDate
        ),

    CONSTRAINT CHK_InternshipAssignments_Status
        CHECK (
            Status IS NULL
            OR Status IN (
                'PLANNED',
                'ONGOING',
                'COMPLETED',
                'CANCELLED'
            )
        )
);


CREATE TABLE InternshipTasks (
    TaskID INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    AssignmentID INT NOT NULL,

    TaskName VARCHAR(200) NOT NULL,
    Description TEXT,

    AssignedDate DATE,
    DueDate DATE,

    Status VARCHAR(20),

    CONSTRAINT FK_InternshipTasks_Assignment
        FOREIGN KEY (AssignmentID)
        REFERENCES InternshipAssignments(AssignmentID)
        ON DELETE CASCADE,

    CONSTRAINT CHK_InternshipTasks_Date
        CHECK (
            AssignedDate IS NULL
            OR DueDate IS NULL
            OR AssignedDate <= DueDate
        ),

    CONSTRAINT CHK_InternshipTasks_Status
        CHECK (
            Status IS NULL
            OR Status IN (
                'TODO',
                'IN_PROGRESS',
                'COMPLETED',
                'CANCELLED'
            )
        )
);


CREATE TABLE TaskProgressUpdates (
    UpdateID INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    TaskID INT NOT NULL,
    UpdatedByStudentID INT NOT NULL,

    UpdateDate TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    ProgressDescription TEXT,
    PercentComplete INT,

    CONSTRAINT FK_TaskProgressUpdates_Task
        FOREIGN KEY (TaskID)
        REFERENCES InternshipTasks(TaskID)
        ON DELETE CASCADE,

    CONSTRAINT FK_TaskProgressUpdates_Student
        FOREIGN KEY (UpdatedByStudentID)
        REFERENCES Students(StudentID)
        ON DELETE RESTRICT,

    CONSTRAINT CHK_TaskProgressUpdates_Percent
        CHECK (
            PercentComplete IS NULL
            OR (
                PercentComplete >= 0
                AND PercentComplete <= 100
            )
        )
);


CREATE TABLE IncidentReports (
    IncidentID INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    AssignmentID INT NOT NULL,
    ReportedBy INT NOT NULL,

    ReportedAt TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    Description TEXT,

    Severity VARCHAR(10),
    Status VARCHAR(20),

    ResolvedAt TIMESTAMPTZ,
    ResolutionNote VARCHAR(500),

    CONSTRAINT FK_IncidentReports_Assignment
        FOREIGN KEY (AssignmentID)
        REFERENCES InternshipAssignments(AssignmentID)
        ON DELETE CASCADE,

    CONSTRAINT FK_IncidentReports_Reporter
        FOREIGN KEY (ReportedBy)
        REFERENCES Users(UserID)
        ON DELETE RESTRICT,

    CONSTRAINT CHK_IncidentReports_Severity
        CHECK (
            Severity IS NULL
            OR Severity IN ('LOW', 'MEDIUM', 'HIGH', 'CRITICAL')
        ),

    CONSTRAINT CHK_IncidentReports_Status
        CHECK (
            Status IS NULL
            OR Status IN ('OPEN', 'IN_PROGRESS', 'RESOLVED', 'CANCELLED')
        ),

    CONSTRAINT CHK_IncidentReports_ResolvedDate
        CHECK (
            Status <> 'RESOLVED'
            OR ResolvedAt IS NOT NULL
        )
);


CREATE TABLE InternshipEvaluations (
    EvaluationID INTEGER GENERATED ALWAYS AS IDENTITY PRIMARY KEY,

    AssignmentID INT NOT NULL UNIQUE,
    EvaluatedBy INT NOT NULL,

    EvaluatedAt TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,

    CompletionScore DECIMAL(4,2),
    AttitudeScore DECIMAL(4,2),
    SkillScore DECIMAL(4,2),
    OverallScore DECIMAL(4,2),

    Comments TEXT,

    Status VARCHAR(20),

    CONSTRAINT FK_InternshipEvaluations_Assignment
        FOREIGN KEY (AssignmentID)
        REFERENCES InternshipAssignments(AssignmentID)
        ON DELETE CASCADE,

    CONSTRAINT FK_InternshipEvaluations_User
        FOREIGN KEY (EvaluatedBy)
        REFERENCES Users(UserID)
        ON DELETE RESTRICT,

    CONSTRAINT CHK_InternshipEvaluations_Scores
        CHECK (
            (CompletionScore IS NULL OR CompletionScore BETWEEN 0 AND 10)
            AND
            (AttitudeScore IS NULL OR AttitudeScore BETWEEN 0 AND 10)
            AND
            (SkillScore IS NULL OR SkillScore BETWEEN 0 AND 10)
            AND
            (OverallScore IS NULL OR OverallScore BETWEEN 0 AND 10)
        ),

    CONSTRAINT CHK_InternshipEvaluations_Status
        CHECK (
            Status IS NULL
            OR Status IN ('DRAFT', 'SUBMITTED', 'FINALIZED')
        )
);


