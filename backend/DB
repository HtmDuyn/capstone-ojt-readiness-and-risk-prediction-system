      ('DEMO-TV-SEC-05', 'SECURITY_INTERN', 'Thực tập An toàn thông tin', 'Hỗ trợ rà soát cấu hình và theo dõi cảnh báo bảo mật.', 'Hiểu mạng máy tính, Linux cơ bản và nguyên tắc an toàn thông tin.', 2, 'TP. Hồ Chí Minh', 'ONSITE', 'IA')
    ) AS x(code, role_code, title, description, requirements, capacity, location, workmode, specialization_code)
  LOOP
SELECT j."JobRoleID" INTO v_job_role_id
