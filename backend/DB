CREATE OR REPLACE FUNCTION public."set_prediction_risk_level"() RETURNS trigger
LANGUAGE plpgsql SET search_path=public AS $f$
DECLARE cfg public."AIModelConfig"%ROWTYPE;
BEGIN
  IF NEW."RiskProbability" IS NULL OR NEW."RiskProbability" NOT BETWEEN 0 AND 1 THEN RAISE EXCEPTION 'RiskProbability must be between 0 and 1'; END IF;
  IF NEW."ConfigID" IS NULL THEN
    SELECT * INTO cfg FROM public."AIModelConfig" WHERE "ModelID"=NEW."ModelID" ORDER BY "UpdatedAt" DESC NULLS LAST,"ConfigID" DESC LIMIT 1;
  ELSE SELECT * INTO cfg FROM public."AIModelConfig" WHERE "ConfigID"=NEW."ConfigID" AND "ModelID"=NEW."ModelID";
  END IF;
  IF NOT FOUND OR cfg."RiskThresholdMedium" IS NULL OR cfg."RiskThresholdHigh" IS NULL THEN RAISE EXCEPTION 'A valid config for this model is required'; END IF;
  IF cfg."RiskLevelMode"='FOUR_LEVEL' AND cfg."RiskThresholdCritical" IS NULL THEN RAISE EXCEPTION 'Critical threshold is required for four-level mode'; END IF;
  NEW."ConfigID" := cfg."ConfigID";
  NEW."RiskLevel" := CASE WHEN cfg."RiskLevelMode"='FOUR_LEVEL' AND NEW."RiskProbability">=cfg."RiskThresholdCritical" THEN 'CRITICAL'
    WHEN NEW."RiskProbability">=cfg."RiskThresholdHigh" THEN 'HIGH' WHEN NEW."RiskProbability">=cfg."RiskThresholdMedium" THEN 'MEDIUM' ELSE 'LOW' END;
  NEW."ThresholdsUsed" := jsonb_build_object('mode',cfg."RiskLevelMode",'medium',cfg."RiskThresholdMedium",'high',cfg."RiskThresholdHigh",'critical',cfg."RiskThresholdCritical");
  RETURN NEW;
END $f$;
