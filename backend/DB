      VALUES
        (v_enterprise_id, v_semester_id, v_row.code, v_row.title,
         v_row.description, v_row.requirements, v_row.capacity, v_row.capacity,
         'OPEN', v_job_role_id, v_row.location, v_row.workmode)
      RETURNING "PositionID" INTO v_position_id;
    END IF;

    -- Do not create duplicate demo posts on rerun. Do not change existing posts.
    SELECT rp."PostID" INTO v_post_id
    FROM public."RecruitmentPosts" rp
    JOIN public."RecruitmentPostPositions" rpp ON rpp."PostID" = rp."PostID"
    WHERE rp."EnterpriseID" = v_enterprise_id
      AND rp."OJTSemesterID" = v_semester_id
      AND rpp."PositionID" = v_position_id
    ORDER BY rp."PostID" LIMIT 1;

    IF v_post_id IS NULL THEN
      INSERT INTO public."RecruitmentPosts"
        ("EnterpriseID", "OJTSemesterID", "WindowID", "Title", "Content", "Benefits",
         "ApplicationInstructions", "Status", "PublishedAt", "DeadlineAt", "CreatedBy")
      VALUES
        (v_enterprise_id, v_semester_id, v_window_id, '[DEMO OJT] ' || v_row.title,
         v_row.description || E'\nYêu cầu: ' || v_row.requirements,
         'Được hướng dẫn công việc và tham gia dự án thực tế (dữ liệu DEMO).',
         'Đăng ký qua hệ thống OJT của trường (chỉ dùng để kiểm thử).',
         'PUBLISHED', now(), now() + interval '21 days', v_user_id)
      RETURNING "PostID" INTO v_post_id;

END IF;

    INSERT INTO public."RecruitmentPostPositions"
      ("PostID", "PositionID", "EnterpriseID", "OJTSemesterID")
    VALUES (v_post_id, v_position_id, v_enterprise_id, v_semester_id);

    INSERT INTO public."PositionSpecializations" ("PositionID", "SpecializationID")
    SELECT v_position_id, sp."SpecializationID"
    FROM public."Specializations" sp
    WHERE sp."SpecializationCode" = v_row.specialization_code;
  END LOOP;

  -- Student registrations/decisions are created through the validated backend workflow.
  RAISE NOTICE 'Seed completed for enterprise TECHVIET, OJT semester % (ID %).', v_semester_code, v_semester_id;
END $seed$;




