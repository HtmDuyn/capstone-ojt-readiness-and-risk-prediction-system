CREATE FUNCTION public."ClassifyStudentCombo"()
 RETURNS trigger
 LANGUAGE plpgsql
 SET search_path TO 'public'
AS $function$
DECLARE combo_code text; combo_group text;
BEGIN
 SELECT "ComboCode","SelectionGroup" INTO STRICT combo_code,combo_group FROM "ProgramCombos" WHERE "ProgramComboID"=NEW."ProgramComboID";
 NEW."SelectionPurpose"=CASE WHEN upper(combo_group) IN ('SPECIALIZATION','PHYSICAL_EDUCATION','OTHER') THEN upper(combo_group)
   WHEN combo_code ~ '^PHE_COM' THEN 'PHYSICAL_EDUCATION'
   WHEN combo_code ~ '^(AI17|IA|IS|SE(-2026)?)_COM' THEN 'SPECIALIZATION' ELSE 'OTHER' END;
 RETURN NEW;
END $function$
;
