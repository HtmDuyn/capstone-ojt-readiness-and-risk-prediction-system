CREATE OR REPLACE FUNCTION public."validate_prediction_snapshot"() RETURNS trigger
LANGUAGE plpgsql SET search_path = public AS $block$
BEGIN
  IF NOT EXISTS (
    SELECT 1 FROM public."StudentAcademicSnapshot" s
    WHERE s."SnapshotID" = NEW."SnapshotID" AND s."StudentID" = NEW."StudentID"
      AND (s."TargetOJTSemesterID" IS NULL OR s."TargetOJTSemesterID" = NEW."OJTSemesterID")
  ) THEN
    RAISE EXCEPTION 'Prediction snapshot must belong to the same student and OJT semester';
  END IF;
  RETURN NEW;
END $block$;
