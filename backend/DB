 SELECT program_id,g."GroupID",pr."CourseID" FROM _demo_prerequisites v JOIN "Courses" c ON c."CourseCode"=v.target JOIN "Courses" pr ON pr."CourseCode"=v.prerequisite
 JOIN "ProgramCourses" pc ON pc."CourseID"=c."CourseID" AND pc."ProgramID"=program_id
 JOIN "ProgramPrerequisiteGroups" g ON g."ProgramCourseID"=pc."ProgramCourseID" AND g."ProgramID"=program_id;

