DO $students$
DECLARE actor_id int; source_program int; program_id int; cohort_id int; entry_id int;
 target_period int; prep_id int; block_id int; term_id int; year_id int; entry_year int; study_stage int;
BEGIN
 SELECT "UserID" INTO STRICT actor_id FROM "Users" WHERE "Email"='academic@ojtrpa.edu.vn';
 SELECT "OJTSemesterID","AcademicPeriodID" INTO STRICT term_id,target_period FROM "OJTSemesters" WHERE "SemesterCode"='DEMO-OJT-S6';
 SELECT period_id INTO STRICT entry_id FROM _demo_study_periods WHERE stage=0;
 SELECT period_id INTO STRICT prep_id FROM _demo_study_periods WHERE stage=5;
 SELECT "AcademicYearID" INTO STRICT year_id FROM "AcademicPeriods" WHERE "AcademicPeriodID"=prep_id;
 SELECT extract(year FROM "StartDate")::int INTO entry_year FROM "AcademicPeriods" WHERE "AcademicPeriodID"=entry_id;
 INSERT INTO "AcademicPeriods" ("AcademicYearID","PeriodCode","Name","Kind","ParentPeriodID","StartDate","EndDate","Status")
 SELECT year_id,'DEMO-PREP-B3','Block 3 - '||"Name",'BLOCK3',prep_id,greatest("StartDate",current_date-30),greatest("StartDate",current_date-1),
 CASE WHEN "StartDate"<current_date THEN 'CLOSED' ELSE 'ACTIVE' END FROM "AcademicPeriods" WHERE "AcademicPeriodID"=prep_id
 RETURNING "AcademicPeriodID" INTO block_id;

 -- Keep the student demo self-contained using actual concrete catalog subjects.
 -- Final publication metadata and prerequisite text are inserted directly.
 SELECT p."ProgramID" INTO STRICT source_program FROM "TrainingPrograms" p
 JOIN "Specializations" sp ON sp."SpecializationID"=p."SpecializationID"
 WHERE sp."SpecializationCode"='SE' AND p."ProgramCode"='BIT_SE_K18D_19A';
 INSERT INTO "TrainingPrograms" ("ProgramCode","ProgramName","TotalCredits","SpecializationID","Version","EffectiveYear","CreatedBy","Status","PrerequisitesReviewed","EquivalencesReviewed","PublishedBy","PublishedAt")
 SELECT 'DEMO-SE-FULL','Khung minh họa SE - 39 môn cụ thể / 114 tín chỉ (không phải CTĐT chính thức)',
  (SELECT sum(pc."Credits") FROM "ProgramCourses" pc WHERE pc."ProgramID"=p."ProgramID" AND pc."EntryKind"='COURSE'),
  p."SpecializationID",'1.0',entry_year,actor_id,'PUBLISHED',true,true,actor_id,now() FROM "TrainingPrograms" p WHERE p."ProgramID"=source_program
 RETURNING "ProgramID" INTO program_id;
 INSERT INTO "ProgramCourses" ("ProgramID","CourseID","CourseName","Credits","RecommendedSemester","IsRequired","EntryKind","PrerequisiteText")
 SELECT program_id,pc."CourseID",pc."CourseName",pc."Credits",pc."RecommendedSemester",true,'COURSE',
  (SELECT string_agg(v.prerequisite,' AND ' ORDER BY v.prerequisite) FROM _demo_prerequisites v WHERE v.target=c."CourseCode")
 FROM "ProgramCourses" pc JOIN "Courses" c USING("CourseID") WHERE pc."ProgramID"=source_program AND pc."EntryKind"='COURSE'
 ORDER BY pc."RecommendedSemester",pc."ProgramCourseID";
 INSERT INTO "AcademicGradingPolicies" ("ProgramID","GpaScale","ConfirmedBy") VALUES(program_id,10,actor_id);

 -- Explicit prerequisite examples apply only to this fictional demo curriculum.
 INSERT INTO "ProgramPrerequisiteGroups" ("ProgramID","ProgramCourseID","GroupCode","MinimumPassed")
 SELECT program_id,pc."ProgramCourseID",'DEMO-ALL',count(*) FROM _demo_prerequisites v JOIN "Courses" c ON c."CourseCode"=v.target
 JOIN "ProgramCourses" pc ON pc."CourseID"=c."CourseID" AND pc."ProgramID"=program_id GROUP BY pc."ProgramCourseID";
