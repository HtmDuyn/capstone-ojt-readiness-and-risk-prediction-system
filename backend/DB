  END IF;

  SELECT eu."UserID" INTO v_user_id
  FROM public."EnterpriseUsers" eu
  JOIN public."Users" u ON u."UserID" = eu."UserID"
  WHERE eu."EnterpriseID" = v_enterprise_id
  ORDER BY CASE WHEN u."Email" = 'hr@techviet.example' THEN 0 ELSE 1 END, eu."UserID"
