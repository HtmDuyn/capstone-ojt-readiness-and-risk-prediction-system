-- 9. Final acceptance. Any failure rolls back the entire reset.
DO $accept_seed$
DECLARE student_id int;
BEGIN
 IF EXISTS(SELECT 1 FROM "AcademicYears" y LEFT JOIN "AcademicPeriods" p
  ON p."AcademicYearID"=y."AcademicYearID" AND p."Kind"='SEMESTER'
  GROUP BY y."AcademicYearID",y."YearCode" HAVING count(p.*)<>3
   OR array_agg(p."PeriodCode" ORDER BY p."StartDate") IS DISTINCT FROM
    ARRAY['SPRING'||left(y."YearCode",4),'SUMMER'||left(y."YearCode",4),'FALL'||left(y."YearCode",4)]::varchar[]) THEN
  RAISE EXCEPTION 'Every academic year requires Spring, Summer and Fall in order.';
 END IF;
 IF EXISTS(SELECT 1 FROM "CohortGroups" g LEFT JOIN "CohortCurriculumPeriods" p USING("CohortID","GroupCode")
  GROUP BY g."CohortID",g."GroupCode" HAVING count(p.*)<>10 OR min(p."CurriculumSemester")<>0 OR max(p."CurriculumSemester")<>9) THEN
  RAISE EXCEPTION 'Every cohort group requires all ten curriculum stages 0..9.';
 END IF;
 IF EXISTS(SELECT 1 FROM "TrainingPrograms" WHERE "Status"<>'PUBLISHED')
  OR EXISTS(SELECT 1 FROM "OJTRuleSets" WHERE "Status"<>'PUBLISHED')
  OR EXISTS(SELECT 1 FROM "RecruitmentPosts" WHERE "Status"='DRAFT')
  OR EXISTS(SELECT 1 FROM "OJTAssessmentWindows" WHERE "Status"='DRAFT') THEN
  RAISE EXCEPTION 'Seeded input must be published/open, never draft.';
 END IF;
 FOR student_id IN SELECT "StudentID" FROM "Students" LOOP
  PERFORM "ValidateStudentStudyHistory"(student_id);
 END LOOP;
 -- Regression fixture: SWE201c failed at stage 4 blocks its stage-5 dependents.
 IF EXISTS(SELECT 1 FROM "StudentCourseResults" r JOIN "Students" s USING("StudentID")
  JOIN "Users" u USING("UserID") JOIN "Courses" c USING("CourseID")
  WHERE u."Username"='student07' AND c."CourseCode" IN ('SWP391','SWR302','SWT301')) THEN
  RAISE EXCEPTION 'A failed prerequisite must block dependent enrollment.';
 END IF;
 IF EXISTS(SELECT 1 FROM "StudentCourseResults" resit JOIN "StudentCourseResults" original
  ON original."StudentID"=resit."StudentID" AND original."CourseID"=resit."CourseID" AND original."AttemptNumber"<resit."AttemptNumber"
  WHERE resit."AttemptNumber">1 AND original."SemesterTaken">=resit."SemesterTaken") THEN
  RAISE EXCEPTION 'Demo resits must belong to a later curriculum stage than the failed attempt.';
 END IF;
END $accept_seed$;
SET CONSTRAINTS ALL IMMEDIATE;

-- BEGIN INCREMENTAL UPDATE: 20261027_pro192_prerequisite
-- Translate only the explicit PRO192 requirement "Pass PRF192".
-- Existing staff-configured groups, other prose and demo curricula are preserved.
DO $pro192_prerequisite$
DECLARE target record; prerequisite_id int; group_id int;
BEGIN
 FOR target IN
  SELECT pc."ProgramID",pc."ProgramCourseID"
  FROM "ProgramCourses" pc
  JOIN "Courses" course USING ("CourseID")
  JOIN "TrainingPrograms" program USING ("ProgramID")
  WHERE upper(course."CourseCode")='PRO192' AND pc."EntryKind"='COURSE'
    AND lower(btrim(pc."PrerequisiteText"))='pass prf192'
    AND program."ProgramCode" NOT LIKE 'DEMO-%'
    AND NOT EXISTS (SELECT 1 FROM "ProgramPrerequisiteGroups" existing
      WHERE existing."ProgramID"=pc."ProgramID" AND existing."ProgramCourseID"=pc."ProgramCourseID")
 LOOP
  SELECT course."CourseID" INTO prerequisite_id
  FROM "ProgramCourses" pc JOIN "Courses" course USING ("CourseID")
  WHERE pc."ProgramID"=target."ProgramID" AND pc."EntryKind"='COURSE'
    AND upper(course."CourseCode")='PRF192';
  IF prerequisite_id IS NULL THEN
   RAISE EXCEPTION 'Cannot configure PRO192: PRF192 is missing from program %.',target."ProgramID";
  END IF;
  INSERT INTO "ProgramPrerequisiteGroups" ("ProgramID","ProgramCourseID","GroupCode","MinimumPassed")
  VALUES (target."ProgramID",target."ProgramCourseID",'PRF192_REQUIRED',1)
  RETURNING "GroupID" INTO group_id;
  INSERT INTO "ProgramPrerequisiteMembers" ("ProgramID","GroupID","CourseID")
  VALUES (target."ProgramID",group_id,prerequisite_id);
 END LOOP;
END $pro192_prerequisite$;
