DO $verify$
BEGIN
 IF (SELECT count(*) FROM "Students")<>20 OR (SELECT count(*) FROM "StudentAcademicPlacements")<>20
 OR (SELECT count(*) FROM "StudentAcademicSnapshot")<>20 THEN
  RAISE EXCEPTION 'The reset must create exactly 20 complete student profiles.';
 END IF;
 IF EXISTS(SELECT 1 FROM "Students" s WHERE s."ProgramID" IS NULL OR NOT EXISTS(SELECT 1 FROM "StudentCourseResults" r WHERE r."StudentID"=s."StudentID")) THEN
  RAISE EXCEPTION 'A demo student is missing a curriculum or course results.';
 END IF;
 IF EXISTS(SELECT 1 FROM "StudentCourseResults" r WHERE r."Status"='IN_PROGRESS' AND r."Score" IS NOT NULL) THEN
  RAISE EXCEPTION 'In-progress courses must not have fabricated grades.';
 END IF;
 IF EXISTS(SELECT 1 FROM "StudentCourseResults" result WHERE result."SemesterTaken" IS DISTINCT FROM "StudentCurriculumSemester"(result."StudentID",result."AcademicPeriodID")) THEN
  RAISE EXCEPTION 'Transcript curriculum stage must match the explicit cohort/calendar mapping.';
 END IF;
 -- The cohort is at curriculum stage 5; stage 6 OJT is in the next calendar semester.
 IF EXISTS(SELECT 1 FROM "Students" student JOIN "StudentAcademicPlacements" placement USING("StudentID") JOIN "AcademicPeriods" period ON period."AcademicPeriodID"=placement."CurrentAcademicPeriodID" WHERE student."CurrentSemester"<>5 OR period."AcademicPeriodID"<>(SELECT period_id FROM _demo_study_periods WHERE stage=5)) THEN
  RAISE EXCEPTION 'Student progress must remain at mapped curriculum stage 5 before the upcoming OJT6 target.';
 END IF;
 IF EXISTS(SELECT 1 FROM "StudentCourseResults" result JOIN "Students" student USING("StudentID") JOIN "AcademicPeriods" period USING("AcademicPeriodID") WHERE result."SemesterTaken">student."CurrentSemester" OR period."StartDate">current_date OR result."AcademicYearID"<>period."AcademicYearID") THEN
  RAISE EXCEPTION 'Transcript contains future courses or an inconsistent semester/year.';
 END IF;
 IF EXISTS(SELECT 1 FROM "StudentCourseResults" result WHERE result."Grade" IS DISTINCT FROM CASE WHEN result."Score" IS NULL THEN NULL WHEN result."Score"<5 THEN 'F' WHEN result."Score">=8 THEN 'A' WHEN result."Score">=7 THEN 'B' WHEN result."Score">=6 THEN 'C' ELSE 'D' END) THEN
  RAISE EXCEPTION 'Letter grades must be calculated from the actual numeric attempt score.';
 END IF;
 IF EXISTS(SELECT 1 FROM _demo_student_cases sample CROSS JOIN LATERAL unnest(sample.failed_codes) failed(code) JOIN "Users" account ON account."Username"='student'||lpad(sample.n::text,2,'0') JOIN "Students" student ON student."UserID"=account."UserID" WHERE NOT EXISTS(SELECT 1 FROM "ProgramCourses" pc JOIN "Courses" course USING("CourseID") WHERE pc."ProgramID"=student."ProgramID" AND course."CourseCode"=failed.code)) THEN
  RAISE EXCEPTION 'A failed/retaken course is missing from the student curriculum.';
 END IF;
 IF EXISTS(SELECT 1 FROM "OJTSemesters" term JOIN "OJTRegistrationWindows" registration_window ON registration_window."OJTSemesterID"=term."OJTSemesterID" WHERE term."SemesterCode"='DEMO-OJT-S6' AND (term."StartDate"<=current_date OR term."Status"<>'PLANNED' OR registration_window."EndsAt">term."StartDate"::timestamptz)) THEN
  RAISE EXCEPTION 'OJT6 must begin after the assessment and registration period.';
 END IF;
END $verify$;
