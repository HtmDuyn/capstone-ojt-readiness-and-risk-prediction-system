PORT=3000

# PostgreSQL / Supabase Session Pooler
DB_HOST=<SUPABASE_SESSION_POOLER_HOST>
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.<PROJECT_REF>
DB_PASSWORD=<YOUR_DATABASE_PASSWORD>
DB_SSL=true

# Authentication
JWT_SECRET=<YOUR_JWT_SECRET>
JWT_EXPIRES_IN=1d

# Frontend origin
CORS_ORIGIN=http://localhost:5173
