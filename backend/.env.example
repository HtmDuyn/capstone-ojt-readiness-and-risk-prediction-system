PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ojt_db
DB_USER=postgres
DB_PASSWORD=

JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_LOGIN_URL=http://localhost:5173/login
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
EMAIL_OUTBOX_KEY=
# Enable only after applying migration and configuring SMTP.
PROVISIONING_JOBS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Durable OJT eligibility batch worker (enabled by default)
ELIGIBILITY_WORKER_ENABLED=true
