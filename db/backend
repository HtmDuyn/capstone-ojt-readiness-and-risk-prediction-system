  'Block 3 - '||semester."Name",'BLOCK3',semester."AcademicPeriodID",
  semester."Block10EndDate"+1,semester."Block10EndDate"+21,semester."Status"
FROM public."AcademicPeriods" semester
WHERE semester."Kind"='SEMESTER'
