  RAISE EXCEPTION 'Student already confirmed in this OJT semester' USING ERRCODE='23514'; END IF;
SELECT "Capacity" INTO cap FROM "InternshipPositions" WHERE "PositionID"=NEW."PositionID" FOR UPDATE;
IF NEW."Source" NOT IN ('QHDN_COORDINATION','QHDN_APPLICATION') AND (cap IS NULL OR public."RecruitmentOccupiedSlots"(NEW."PositionID")>=cap) THEN
  RAISE EXCEPTION 'Shared semester capacity is exhausted' USING ERRCODE='23514'; END IF;
RETURN NEW;
END $$;

