-- Map each combo subject to all interchangeable combo slots in its curriculum:
-- the combo-family prefix and curriculum semester must both match.
-- SE-2026 source combo codes have both SE-2026_COM and legacy SE_COM spellings.
WITH slots AS (
  SELECT pc."ProgramID",pc."ProgramCourseID",pc."RecommendedSemester",pc."Credits",
    CASE WHEN left(upper(c."CourseCode"),11)='SE-2026_COM' THEN 'SE_COM'
        ELSE regexp_replace(upper(c."CourseCode"),'\*.*$','') END AS "Family"
  FROM public."ProgramCourses" pc JOIN public."Courses" c USING ("CourseID")
  WHERE pc."EntryKind"='COMBO_SLOT'
), combos AS (
  SELECT b."ProgramID",b."ProgramComboID",
    CASE WHEN left(upper(b."ComboCode"),11)='SE-2026_COM' THEN 'SE_COM'
        ELSE split_part(upper(b."ComboCode"),'_COM',1)||'_COM' END AS "Family"
  FROM public."ProgramCombos" b
)
INSERT INTO public."ProgramSlotOptions" ("ProgramID","ProgramCourseID","ProgramComboID","ComboCourseID")
SELECT DISTINCT s."ProgramID",s."ProgramCourseID",b."ProgramComboID",cc."ComboCourseID"
FROM slots s JOIN combos f ON f."ProgramID"=s."ProgramID" AND f."Family"=s."Family"
JOIN public."ProgramCombos" b ON b."ProgramID"=f."ProgramID" AND b."ProgramComboID"=f."ProgramComboID"
JOIN public."ComboCourses" cc ON cc."ProgramComboID"=b."ProgramComboID"
  AND cc."Semester"=s."RecommendedSemester"
WHERE cc."Credits" IS NULL OR cc."Credits"=s."Credits";

-- Every mapped combo subject inherits the matching slot credit weight.
WITH weights AS (
  SELECT option."ProgramComboID",option."ComboCourseID",min(slot."Credits") AS "Credits",
    count(DISTINCT slot."Credits") AS "CreditVariants"
  FROM public."ProgramSlotOptions" option
  JOIN public."ProgramCourses" slot ON slot."ProgramCourseID"=option."ProgramCourseID"
  GROUP BY option."ProgramComboID",option."ComboCourseID"
)
UPDATE public."ComboCourses" cc SET "Credits"=weights."Credits"
FROM weights
WHERE cc."ProgramComboID"=weights."ProgramComboID"
  AND cc."ComboCourseID"=weights."ComboCourseID"
  AND cc."Credits" IS NULL AND weights."CreditVariants"=1;

