DO $curriculum_sequences$
DECLARE entry record; maximum bigint;
BEGIN
  FOR entry IN SELECT * FROM (VALUES
      ('AcademicMajors','MajorID'),('Specializations','SpecializationID'),
      ('TrainingPrograms','ProgramID'),('Courses','CourseID'),
      ('ProgramCourses','ProgramCourseID'),('ProgramCombos','ProgramComboID'),
      ('ComboCourses','ComboCourseID'),('ComboCourseChoiceGroups','ChoiceGroupID')
  ) AS t(tab,col) LOOP
    EXECUTE format('SELECT max(%I) FROM public.%I',entry.col,entry.tab) INTO maximum;
    IF maximum IS NOT NULL THEN
      PERFORM setval(pg_get_serial_sequence(format('public.%I',entry.tab),entry.col),maximum,true);
    END IF;
  END LOOP;
END $curriculum_sequences$;

