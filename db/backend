-- Convert source prerequisite prose when it is a list of exact course codes:
-- commas mean every clause is required; OR means one course in that clause.
-- Only create a complete mapping when every named code resolves to an earlier course.
WITH targets AS (
  SELECT target."ProgramID",target."ProgramCourseID",target."RecommendedSemester",
    CASE
      WHEN program."ProgramCode" LIKE 'BIT_AI%'
        AND target."PrerequisiteText" ILIKE '%not applied to the BIT_AI%' THEN ''
      ELSE regexp_replace(
        regexp_replace(upper(btrim(target."PrerequisiteText")), '[[:space:]]*\([^)]*\).*$', ''),
        '^PASS[[:space:]]+', '')
    END AS "PrerequisiteText"
  FROM public."ProgramCourses" target
  JOIN public."TrainingPrograms" program ON program."ProgramID"=target."ProgramID"
  WHERE target."EntryKind"='COURSE'
    AND target."RecommendedSemester" BETWEEN 0 AND 9
    AND EXISTS (SELECT 1 FROM qhdn_student_roster r WHERE r."ProgramID"=target."ProgramID")
    AND lower(btrim(COALESCE(target."PrerequisiteText",''))) NOT IN ('','none','n/a','na','không','no','-')
    AND NOT (program."ProgramCode" LIKE 'BIT_AI%'
      AND target."PrerequisiteText" ILIKE '%not applied to the BIT_AI%')
    AND NOT EXISTS (SELECT 1 FROM public."ProgramPrerequisiteGroups" g
      WHERE g."ProgramID"=target."ProgramID" AND g."ProgramCourseID"=target."ProgramCourseID")
), clauses AS (
  SELECT t.*,clause.ordinality AS "ClauseNumber",btrim(clause.value) AS "ClauseText"
  FROM targets t CROSS JOIN LATERAL regexp_split_to_table(t."PrerequisiteText",'[[:space:]]*,[[:space:]]*')
    WITH ORDINALITY AS clause(value,ordinality)
), alternatives AS (
  SELECT c."ProgramID",c."ProgramCourseID",c."RecommendedSemester",c."ClauseNumber",
    regexp_replace(upper(btrim(alternative.value)), '^PASS[[:space:]]+', '') AS "CourseCode"
  FROM clauses c CROSS JOIN LATERAL regexp_split_to_table(c."ClauseText",'[[:space:]]+OR[[:space:]]+')
    AS alternative(value)
), resolved AS (
  SELECT a."ProgramID",a."ProgramCourseID",a."RecommendedSemester",a."ClauseNumber",
    a."CourseCode",prerequisite."CourseID"
  FROM alternatives a JOIN public."Courses" course ON upper(course."CourseCode")=a."CourseCode"
  JOIN public."ProgramCourses" prerequisite ON prerequisite."ProgramID"=a."ProgramID"
    AND prerequisite."CourseID"=course."CourseID" AND prerequisite."EntryKind"='COURSE'
    AND prerequisite."RecommendedSemester"<a."RecommendedSemester"
), complete_targets AS (
  SELECT t."ProgramID",t."ProgramCourseID"
  FROM targets t JOIN alternatives a USING ("ProgramID","ProgramCourseID")
  LEFT JOIN resolved r USING ("ProgramID","ProgramCourseID","ClauseNumber","CourseCode")
  GROUP BY t."ProgramID",t."ProgramCourseID"
  HAVING count(*)=count(r."CourseID")
), added AS (
  INSERT INTO public."ProgramPrerequisiteGroups" ("ProgramID","ProgramCourseID","GroupCode","MinimumPassed")
  SELECT DISTINCT r."ProgramID",r."ProgramCourseID",'SOURCE_CLAUSE_'||r."ClauseNumber",1
  FROM resolved r JOIN complete_targets t USING ("ProgramID","ProgramCourseID")
  ON CONFLICT ("ProgramCourseID","GroupCode") DO NOTHING
  RETURNING "ProgramID","ProgramCourseID","GroupID"
)
INSERT INTO public."ProgramPrerequisiteMembers" ("ProgramID","GroupID","CourseID")
SELECT r."ProgramID",g."GroupID",r."CourseID"
FROM resolved r JOIN complete_targets t USING ("ProgramID","ProgramCourseID")
JOIN public."ProgramPrerequisiteGroups" g ON g."ProgramID"=r."ProgramID"
  AND g."ProgramCourseID"=r."ProgramCourseID" AND g."GroupCode"='SOURCE_CLAUSE_'||r."ClauseNumber"
ON CONFLICT ("GroupID","CourseID") DO NOTHING;

-- Build the history from required courses plus the selected source-curriculum prerequisite courses.
-- For OR clauses, choose one stable option; separate comma clauses remain independently required.
CREATE TEMP TABLE qhdn_study_courses ON COMMIT DROP AS
WITH required_courses AS (
  SELECT pc."ProgramID",pc."ProgramCourseID",pc."CourseID",pc."RecommendedSemester"
  FROM public."ProgramCourses" pc
  WHERE pc."EntryKind"='COURSE' AND pc."IsRequired"=true AND pc."Credits">0
    AND pc."RecommendedSemester" BETWEEN 1 AND 9
    AND NOT EXISTS (SELECT 1 FROM public."Courses" course WHERE course."CourseID"=pc."CourseID" AND upper(course."CourseCode")='OJT202')
    AND EXISTS (SELECT 1 FROM qhdn_student_roster roster WHERE roster."ProgramID"=pc."ProgramID")
), selected_prerequisites AS (
  SELECT prerequisite."ProgramID",prerequisite."CourseID"
  FROM required_courses target
  JOIN public."ProgramPrerequisiteGroups" group_row
    ON group_row."ProgramID"=target."ProgramID" AND group_row."ProgramCourseID"=target."ProgramCourseID"
  JOIN LATERAL (
    SELECT member."CourseID",row_number() OVER (ORDER BY course."CourseCode",member."CourseID") AS "OptionNumber"
    FROM public."ProgramPrerequisiteMembers" member
    JOIN public."Courses" course ON course."CourseID"=member."CourseID"
    WHERE member."GroupID"=group_row."GroupID"
  ) choice ON choice."OptionNumber"<=group_row."MinimumPassed"
  JOIN public."ProgramCourses" prerequisite ON prerequisite."ProgramID"=target."ProgramID"
    AND prerequisite."CourseID"=choice."CourseID" AND prerequisite."EntryKind"='COURSE'
    AND prerequisite."Credits">0 AND prerequisite."RecommendedSemester" BETWEEN 0 AND 9
    AND NOT EXISTS (SELECT 1 FROM public."Courses" course WHERE course."CourseID"=prerequisite."CourseID" AND upper(course."CourseCode")='OJT202')
  GROUP BY prerequisite."ProgramID",prerequisite."CourseID"
)
SELECT "ProgramID","ProgramCourseID","CourseID","RecommendedSemester" FROM required_courses
UNION
SELECT prerequisite."ProgramID",prerequisite."ProgramCourseID",prerequisite."CourseID",prerequisite."RecommendedSemester"
FROM selected_prerequisites selected
JOIN public."ProgramCourses" prerequisite ON prerequisite."ProgramID"=selected."ProgramID"
  AND prerequisite."CourseID"=selected."CourseID" AND prerequisite."EntryKind"='COURSE';

-- Place no more than five normal curriculum courses in one semester.
-- Delayed courses retain their source recommendation but are recorded in the semester actually taken.
CREATE TEMP TABLE qhdn_student_study_schedule (
  "StudentID" integer NOT NULL,
  "ProgramID" integer NOT NULL,
  "ProgramCourseID" integer NOT NULL,
  "CourseID" integer NOT NULL,
  "RecommendedSemester" integer NOT NULL,
  "SemesterTaken" integer NOT NULL,
  PRIMARY KEY ("StudentID","ProgramCourseID")
) ON COMMIT DROP;

DO $schedule_study_history$
DECLARE student record; stage integer; candidate record; assigned_count integer;
BEGIN
  FOR student IN
    SELECT s."StudentID",s."ProgramID",
      CASE WHEN roster."CompletedOJT" THEN s."CurrentSemester"
           WHEN roster."Number" IN (13,14,17,18,21,22,81,82,83,84) THEN 5
           WHEN roster."Number" IN (41,42,43,44) THEN 5
           ELSE LEAST(s."CurrentSemester",2) END AS "CurrentSemester"
    FROM qhdn_student_roster roster
    JOIN public."Users" account ON account."Email"=roster."Email"
    JOIN public."Students" s ON s."UserID"=account."UserID" AND s."ProgramID"=roster."ProgramID"
    ORDER BY s."StudentID"
  LOOP
    FOR stage IN 0..student."CurrentSemester" LOOP
      SELECT count(*) INTO assigned_count FROM qhdn_student_study_schedule
      WHERE "StudentID"=student."StudentID" AND "SemesterTaken"=stage;
      FOR candidate IN
        SELECT study_course."ProgramCourseID",study_course."CourseID",study_course."RecommendedSemester"
        FROM qhdn_study_courses study_course
        JOIN public."ProgramCourses" pc ON pc."ProgramCourseID"=study_course."ProgramCourseID"
        WHERE study_course."ProgramID"=student."ProgramID"
          AND study_course."RecommendedSemester"<=stage
          AND (lower(btrim(COALESCE(pc."PrerequisiteText",''))) IN ('','none','n/a','na','không','no','-')
            OR EXISTS (SELECT 1 FROM public."TrainingPrograms" program
              WHERE program."ProgramID"=pc."ProgramID" AND program."ProgramCode" LIKE 'BIT_AI%'
                AND pc."PrerequisiteText" ILIKE '%not applied to the BIT_AI%')
            OR EXISTS (SELECT 1 FROM public."ProgramPrerequisiteGroups" g
              WHERE g."ProgramID"=pc."ProgramID" AND g."ProgramCourseID"=pc."ProgramCourseID"))
          AND NOT EXISTS (SELECT 1 FROM public."ProgramPrerequisiteGroups" g
            WHERE g."ProgramID"=pc."ProgramID" AND g."ProgramCourseID"=pc."ProgramCourseID"
              AND g."MinimumPassed">(
                SELECT count(*) FROM public."ProgramPrerequisiteMembers" member
                WHERE member."GroupID"=g."GroupID" AND EXISTS (
                  SELECT 1 FROM qhdn_student_study_schedule passed
                  WHERE passed."StudentID"=student."StudentID" AND passed."CourseID"=member."CourseID"
                    AND passed."SemesterTaken"<stage)))
          AND NOT EXISTS (SELECT 1 FROM qhdn_student_study_schedule existing
            WHERE existing."StudentID"=student."StudentID"
              AND existing."ProgramCourseID"=study_course."ProgramCourseID")
        ORDER BY study_course."RecommendedSemester",study_course."CourseID"
      LOOP
        EXIT WHEN assigned_count>=5;
        INSERT INTO qhdn_student_study_schedule
          ("StudentID","ProgramID","ProgramCourseID","CourseID","RecommendedSemester","SemesterTaken")
        VALUES (student."StudentID",student."ProgramID",candidate."ProgramCourseID",candidate."CourseID",
          candidate."RecommendedSemester",stage);
        assigned_count:=assigned_count+1;
      END LOOP;
    END LOOP;
  END LOOP;
END $schedule_study_history$;

-- Preserve one failed course for each of the ten existing ineligible students;
-- Each remaining non-completed sample retains one failed course.
CREATE TEMP TABLE qhdn_student_course_failures ON COMMIT DROP AS
WITH ranked_courses AS (
SELECT schedule."StudentID",schedule."ProgramID",schedule."ProgramCourseID",
  schedule."CourseID",schedule."SemesterTaken",roster."Number",
  row_number() OVER (PARTITION BY schedule."StudentID"
    ORDER BY schedule."SemesterTaken" DESC,schedule."RecommendedSemester" DESC,schedule."CourseID" DESC) AS "FailureNumber"
FROM qhdn_student_study_schedule schedule
JOIN public."Students" student ON student."StudentID"=schedule."StudentID"
JOIN public."Users" account ON account."UserID"=student."UserID"
JOIN qhdn_student_roster roster ON roster."Email"=account."Email" AND roster."ProgramID"=schedule."ProgramID"
WHERE roster."Number" IN (13,14,17,18,21,22,81,82,83,84) AND schedule."SemesterTaken">0
  AND NOT EXISTS (SELECT 1 FROM public."StudentCourseResults" existing
    WHERE existing."StudentID"=schedule."StudentID" AND existing."CourseID"=schedule."CourseID"
      AND existing."Status" IN ('PASSED','RECOGNIZED'))
)
SELECT "StudentID","ProgramID","ProgramCourseID","CourseID","SemesterTaken"
FROM ranked_courses
WHERE "FailureNumber"<=1;

DO $seed_study_history$
DECLARE stage integer;
BEGIN
  FOR stage IN 0..9 LOOP
    INSERT INTO public."StudentCourseResults" ("StudentID","CourseID","SemesterTaken","AcademicYearID","Score","Grade","Status","AcademicPeriodID","AttemptNumber","GradePoints","SourceReference","RecordedBy")
    SELECT failure."StudentID",failure."CourseID",failure."SemesterTaken",period."AcademicYearID",4.00,'F','FAILED',period."AcademicPeriodID",1,0.00,'QHDN_HANDOFF_2026_FAILED_COURSE',academic."UserID"
    FROM qhdn_student_course_failures failure
    JOIN public."StudentAcademicPlacements" placement ON placement."StudentID"=failure."StudentID"
    JOIN public."CohortCurriculumPeriods" curriculum_period
      ON curriculum_period."CohortID"=placement."CohortID" AND curriculum_period."GroupCode"=placement."GroupCode"
      AND curriculum_period."CurriculumSemester"=failure."SemesterTaken"
    JOIN public."AcademicPeriods" period ON period."AcademicPeriodID"=curriculum_period."AcademicPeriodID"
    JOIN public."Users" academic ON academic."Username"='academic01'
    WHERE failure."SemesterTaken"=stage
      AND NOT EXISTS (SELECT 1 FROM public."StudentCourseResults" old
        WHERE old."StudentID"=failure."StudentID" AND old."CourseID"=failure."CourseID"
          AND old."AcademicPeriodID"=period."AcademicPeriodID" AND old."AttemptNumber"=1);

    INSERT INTO public."StudentCourseResults" ("StudentID","CourseID","SemesterTaken","AcademicYearID","Score","Grade","Status","AcademicPeriodID","AttemptNumber","GradePoints","SourceReference","RecordedBy")
    SELECT schedule."StudentID",schedule."CourseID",schedule."SemesterTaken",period."AcademicYearID",8.00,'B','PASSED',period."AcademicPeriodID",1,3.00,'QHDN_HANDOFF_2026',academic."UserID"
    FROM qhdn_student_study_schedule schedule
    JOIN public."StudentAcademicPlacements" placement ON placement."StudentID"=schedule."StudentID"
    JOIN public."CohortCurriculumPeriods" curriculum_period
      ON curriculum_period."CohortID"=placement."CohortID" AND curriculum_period."GroupCode"=placement."GroupCode"
      AND curriculum_period."CurriculumSemester"=schedule."SemesterTaken"
    JOIN public."AcademicPeriods" period ON period."AcademicPeriodID"=curriculum_period."AcademicPeriodID"
    JOIN public."Users" academic ON academic."Username"='academic01'
    WHERE schedule."SemesterTaken"=stage
      AND NOT EXISTS (SELECT 1 FROM qhdn_student_course_failures failure
        WHERE failure."StudentID"=schedule."StudentID" AND failure."ProgramCourseID"=schedule."ProgramCourseID")
      AND NOT EXISTS (SELECT 1 FROM public."StudentCourseResults" old
        WHERE old."StudentID"=schedule."StudentID" AND old."CourseID"=schedule."CourseID"
          AND old."AcademicPeriodID"=period."AcademicPeriodID" AND old."AttemptNumber"=1);
  END LOOP;
END $seed_study_history$;

-- Add the missing transcript grades for the six completed-OJT students.
-- PrerequisiteText was reviewed manually: each comma-separated requirement
-- below must have a prior passing course; alternatives separated by | are OR.
-- These rows are inserted directly into StudentCourseResults; curriculum
-- prerequisites and mapping tables remain untouched.
DO $seed_completed_transcript_grades$
DECLARE stage integer;
BEGIN
  FOR stage IN 1..5 LOOP
    INSERT INTO public."StudentCourseResults"
      ("StudentID","CourseID","SemesterTaken","AcademicYearID","Score","Grade","Status",
       "AcademicPeriodID","AttemptNumber","GradePoints","SourceReference","RecordedBy")
    WITH course_rows AS (
      SELECT * FROM (VALUES
        ('BIT_IS_K18D_19A','MAE101',1,NULL::text,NULL::text,NULL::text),
        ('BIT_IS_K18D_19A','CSD201',3,'PRO192',NULL,NULL),
        ('BIT_IS_K18D_19A','LAB211',3,'PRO192',NULL,NULL),
        ('BIT_IS_K18D_19A','MAS291',4,'MAE101|MAC101',NULL,NULL),
        ('BIT_IS_K18D_19A','JPD123',4,'JPD113',NULL,NULL),
        ('BIT_IS_K18D_19A','SWE201c',4,'PRO192',NULL,NULL),
        ('BIT_IS_K18D_19A','PRJ302',4,'DBI202','PRO192',NULL),
        ('BIT_IS_K18D_19A','ISP392',5,'PRJ302','SWE201c','LAB211'),
        ('BIT_IS_K18D_19A','ITA301',5,'ITA203c','DBI202',NULL),
        ('BIT_SE_K18D_19A','CSD201',3,'PRO192',NULL,NULL),
        ('BIT_SE_K18D_19A','LAB211',3,'PRO192',NULL,NULL),
        ('BIT_SE_K18D_19A','MAS291',4,'MAE101|MAC101',NULL,NULL),
        ('BIT_SE_K18D_19A','JPD123',4,'JPD113',NULL,NULL),
        ('BIT_SE_K18D_19A','SWE201c',4,'PRO192',NULL,NULL),
        ('BIT_SE_K18D_19A','PRJ301',4,'DBI202','PRO192',NULL),
        ('BIT_SE_K18D_19A','SWP391',5,'PRJ301','SWE201c|SWE202c','LAB211'),
        ('BIT_SE_K18D_19A','SWR302',5,'SWE102|SWE201c|SWE202c',NULL,NULL),
        ('BIT_SE_K18D_19A','SWT301',5,'SWE102|SWE201c|SWE202c',NULL,NULL)
      ) AS rows("ProgramCode","CourseCode","SemesterTaken","PrerequisiteClause1","PrerequisiteClause2","PrerequisiteClause3")
    ), targets AS (
      SELECT roster."Number",student."StudentID",student."ProgramID",program."ProgramCode",
        course_row."CourseID",pc."ProgramCourseID",curriculum_period."AcademicPeriodID",period."AcademicYearID",
        period."StartDate",row."PrerequisiteClause1",row."PrerequisiteClause2",row."PrerequisiteClause3"
      FROM qhdn_student_roster roster
      JOIN public."Users" account ON account."Email"=roster."Email"
      JOIN public."Students" student ON student."UserID"=account."UserID" AND student."ProgramID"=roster."ProgramID"
      JOIN public."TrainingPrograms" program ON program."ProgramID"=student."ProgramID"
      JOIN course_rows row ON row."ProgramCode"=program."ProgramCode" AND row."SemesterTaken"=stage
      JOIN public."Courses" course_row ON upper(course_row."CourseCode")=upper(row."CourseCode")
      JOIN public."ProgramCourses" pc ON pc."ProgramID"=student."ProgramID" AND pc."CourseID"=course_row."CourseID"
        AND pc."EntryKind"='COURSE' AND pc."IsRequired"=true AND pc."Credits">0
        AND pc."RecommendedSemester"=row."SemesterTaken"
      JOIN public."StudentAcademicPlacements" placement ON placement."StudentID"=student."StudentID"
      JOIN public."CohortCurriculumPeriods" curriculum_period ON curriculum_period."CohortID"=placement."CohortID"
        AND curriculum_period."GroupCode"=placement."GroupCode" AND curriculum_period."CurriculumSemester"=stage
      JOIN public."AcademicPeriods" period ON period."AcademicPeriodID"=curriculum_period."AcademicPeriodID"
      WHERE roster."CompletedOJT"
    )
    SELECT target."StudentID",target."CourseID",stage,
      CASE WHEN pass_period."AcademicPeriodID"=target."AcademicPeriodID"
        THEN target."AcademicYearID" ELSE block3."AcademicYearID" END,
      8.00,'B','PASSED',pass_period."AcademicPeriodID",
      COALESCE((
        SELECT max(existing."AttemptNumber") FROM public."StudentCourseResults" existing
        LEFT JOIN public."AcademicPeriods" existing_period ON existing_period."AcademicPeriodID"=existing."AcademicPeriodID"
        WHERE existing."StudentID"=target."StudentID" AND existing."CourseID"=target."CourseID"
          AND (existing."AcademicPeriodID"=target."AcademicPeriodID" OR existing_period."ParentPeriodID"=target."AcademicPeriodID")
      ),0)+1,
      3.00,'QHDN_HANDOFF_2026_PREREQUISITE_GRADE',academic."UserID"
    FROM targets target
    JOIN public."Users" academic ON academic."Username"='academic01'
    LEFT JOIN LATERAL (
      SELECT block."AcademicPeriodID",block."AcademicYearID"
      FROM public."AcademicPeriods" block
      WHERE block."ParentPeriodID"=target."AcademicPeriodID" AND block."Kind"='BLOCK3'
      ORDER BY block."StartDate" LIMIT 1
    ) block3 ON true
    CROSS JOIN LATERAL (
      SELECT CASE WHEN EXISTS (
        SELECT 1 FROM public."StudentCourseResults" existing
        WHERE existing."StudentID"=target."StudentID" AND existing."CourseID"=target."CourseID"
          AND existing."AcademicPeriodID"=target."AcademicPeriodID"
      ) THEN COALESCE(block3."AcademicPeriodID",target."AcademicPeriodID")
        ELSE target."AcademicPeriodID" END AS "AcademicPeriodID"
    ) pass_period
    WHERE NOT EXISTS (
        SELECT 1 FROM public."StudentCourseResults" existing
        LEFT JOIN public."AcademicPeriods" existing_period ON existing_period."AcademicPeriodID"=existing."AcademicPeriodID"
        WHERE existing."StudentID"=target."StudentID" AND existing."CourseID"=target."CourseID"
          AND existing."Status" IN ('PASSED','RECOGNIZED')
          AND (existing."AcademicPeriodID"=target."AcademicPeriodID" OR existing_period."ParentPeriodID"=target."AcademicPeriodID")
      )
      AND (target."PrerequisiteClause1" IS NULL OR EXISTS (
        SELECT 1 FROM public."StudentCourseResults" prior
        JOIN public."Courses" prerequisite ON prerequisite."CourseID"=prior."CourseID"
        JOIN public."AcademicPeriods" prior_period ON prior_period."AcademicPeriodID"=prior."AcademicPeriodID"
        WHERE prior."StudentID"=target."StudentID" AND prior."Status" IN ('PASSED','RECOGNIZED')
          AND prior_period."StartDate"<target."StartDate"
          AND upper(prerequisite."CourseCode")=ANY(string_to_array(upper(target."PrerequisiteClause1"),'|'))
      ))
      AND (target."PrerequisiteClause2" IS NULL OR EXISTS (
        SELECT 1 FROM public."StudentCourseResults" prior
        JOIN public."Courses" prerequisite ON prerequisite."CourseID"=prior."CourseID"
        JOIN public."AcademicPeriods" prior_period ON prior_period."AcademicPeriodID"=prior."AcademicPeriodID"
        WHERE prior."StudentID"=target."StudentID" AND prior."Status" IN ('PASSED','RECOGNIZED')
          AND prior_period."StartDate"<target."StartDate"
          AND upper(prerequisite."CourseCode")=ANY(string_to_array(upper(target."PrerequisiteClause2"),'|'))
      ))
      AND (target."PrerequisiteClause3" IS NULL OR EXISTS (
        SELECT 1 FROM public."StudentCourseResults" prior
        JOIN public."Courses" prerequisite ON prerequisite."CourseID"=prior."CourseID"
        JOIN public."AcademicPeriods" prior_period ON prior_period."AcademicPeriodID"=prior."AcademicPeriodID"
        WHERE prior."StudentID"=target."StudentID" AND prior."Status" IN ('PASSED','RECOGNIZED')
          AND prior_period."StartDate"<target."StartDate"
          AND upper(prerequisite."CourseCode")=ANY(string_to_array(upper(target."PrerequisiteClause3"),'|'))
      ))
    ON CONFLICT ("StudentID","CourseID","AcademicPeriodID","AttemptNumber")
      WHERE "AcademicPeriodID" IS NOT NULL DO NOTHING;
  END LOOP;
END $seed_completed_transcript_grades$;

-- Pick a concrete instrument from each student's existing TMI_ELE slot options.
CREATE TEMP TABLE qhdn_student_instruments ON COMMIT DROP AS
SELECT s."StudentID",s."ProgramID",choice."ProgramComboID",choice."ComboCourseID",choice."CourseID",
  choice."RecommendedSemester",period."AcademicPeriodID",period."AcademicYearID",period."EndDate"
FROM qhdn_student_roster roster
JOIN public."Users" u ON u."Email"=roster."Email"
JOIN public."Students" s ON s."UserID"=u."UserID" AND s."ProgramID"=roster."ProgramID"
JOIN LATERAL (
  SELECT opt."ProgramComboID",cc."ComboCourseID",cc."CourseID",slot."RecommendedSemester"
  FROM public."ProgramCourses" slot
  JOIN public."Courses" placeholder ON placeholder."CourseID"=slot."CourseID"
  JOIN public."ProgramSlotOptions" opt ON opt."ProgramID"=s."ProgramID" AND opt."ProgramCourseID"=slot."ProgramCourseID"
  JOIN public."ProgramCombos" combo ON combo."ProgramComboID"=opt."ProgramComboID" AND combo."ProgramID"=s."ProgramID" AND combo."CoursesReviewed"
  JOIN public."ComboCourses" cc ON cc."ProgramComboID"=opt."ProgramComboID" AND cc."ComboCourseID"=opt."ComboCourseID"
  JOIN public."Courses" instrument ON instrument."CourseID"=cc."CourseID"
  WHERE slot."ProgramID"=s."ProgramID" AND slot."EntryKind"='ELECTIVE_SLOT'
    AND placeholder."CourseCode"='TMI_ELE' AND cc."Semester"=slot."RecommendedSemester"
    AND slot."RecommendedSemester"<=CASE WHEN roster."CompletedOJT" THEN s."CurrentSemester"
      WHEN roster."Number" IN (13,14,17,18,21,22,81,82,83,84) THEN 5 ELSE 2 END
  ORDER BY instrument."CourseCode",cc."ComboCourseID"
  OFFSET ((roster."Number"-1)%7) LIMIT 1
) choice ON true
JOIN public."StudentAcademicPlacements" placement ON placement."StudentID"=s."StudentID"
JOIN public."CohortCurriculumPeriods" mapping ON mapping."CohortID"=placement."CohortID"
  AND mapping."GroupCode"=placement."GroupCode" AND mapping."CurriculumSemester"=choice."RecommendedSemester"
JOIN public."AcademicPeriods" period ON period."AcademicPeriodID"=mapping."AcademicPeriodID"
WHERE roster."CompletedOJT";

