CREATE OR REPLACE FUNCTION public."GuardRecruitmentRound"() RETURNS trigger
LANGUAGE plpgsql SET search_path=public,pg_catalog AS $$
BEGIN
PERFORM pg_advisory_xact_lock(hashtext('academic-calendar'));
IF TG_OP='UPDATE' THEN
  IF ROW(NEW."CampaignID",NEW."RoundNumber",NEW."OJTSemesterID",NEW."AcademicPeriodID",NEW."StartsAt",NEW."EndsAt",
    NEW."PostingStartsAt",NEW."PostingEndsAt",NEW."ApplicationStartsAt",NEW."ApplicationEndsAt",NEW."ResultsStartsAt",NEW."ResultsEndsAt")
  IS DISTINCT FROM ROW(OLD."CampaignID",OLD."RoundNumber",OLD."OJTSemesterID",OLD."AcademicPeriodID",OLD."StartsAt",OLD."EndsAt",
    OLD."PostingStartsAt",OLD."PostingEndsAt",OLD."ApplicationStartsAt",OLD."ApplicationEndsAt",OLD."ResultsStartsAt",OLD."ResultsEndsAt") THEN
  RAISE EXCEPTION 'Recruitment deadlines are immutable after creation' USING ERRCODE='23514';
  END IF;
  IF OLD."ResultsFinalizedAt" IS NOT NULL AND NEW IS DISTINCT FROM OLD THEN
  RAISE EXCEPTION 'Finalized recruitment round is immutable' USING ERRCODE='23514';
  END IF;
END IF;
IF NEW."CampaignID" IS NULL THEN RETURN NEW; END IF;
IF NEW."RoundNumber" IS NULL OR NEW."RoundNumber"<1 OR NEW."PostingStartsAt" IS NULL OR NEW."PostingEndsAt" IS NULL
  OR NEW."ApplicationStartsAt" IS NULL OR NEW."ApplicationEndsAt" IS NULL OR NEW."ResultsStartsAt" IS NULL OR NEW."ResultsEndsAt" IS NULL
  OR NOT (NEW."StartsAt"=NEW."PostingStartsAt" AND NEW."EndsAt"=NEW."ResultsEndsAt"
  AND NEW."PostingStartsAt"<NEW."PostingEndsAt" AND NEW."PostingEndsAt"<=NEW."ApplicationStartsAt"
  AND NEW."ApplicationStartsAt"<NEW."ApplicationEndsAt" AND NEW."ApplicationEndsAt"<=NEW."ResultsStartsAt"
  AND NEW."ResultsStartsAt"<NEW."ResultsEndsAt") THEN
  RAISE EXCEPTION 'Three sequential non-overlapping phases are required' USING ERRCODE='23514';
END IF;
IF NOT EXISTS(SELECT 1 FROM "RecruitmentCampaigns" c WHERE c."CampaignID"=NEW."CampaignID" AND c."OJTSemesterID"=NEW."OJTSemesterID") THEN
  RAISE EXCEPTION 'Campaign semester mismatch' USING ERRCODE='23514'; END IF;
IF EXISTS(SELECT 1 FROM "RecruitmentWindows" w WHERE w."OJTSemesterID"=NEW."OJTSemesterID" AND w."WindowID"<>NEW."WindowID"
  AND w."StartsAt"<NEW."EndsAt" AND w."EndsAt">NEW."StartsAt") THEN
  RAISE EXCEPTION 'Recruitment rounds cannot overlap' USING ERRCODE='23514'; END IF;
IF TG_OP='INSERT' AND EXISTS(SELECT 1 FROM "RecruitmentWindows" w WHERE w."CampaignID"=NEW."CampaignID"
  AND (w."RoundNumber">=NEW."RoundNumber" OR w."EndsAt">NEW."StartsAt")) THEN
  RAISE EXCEPTION 'Recruitment rounds must follow their sequence' USING ERRCODE='23514'; END IF;
IF NEW."Status"='OPEN' AND (TG_OP='INSERT' OR OLD."Status" IS DISTINCT FROM 'OPEN') AND EXISTS(
  SELECT 1 FROM "RecruitmentWindows" w WHERE w."OJTSemesterID"=NEW."OJTSemesterID" AND w."WindowID"<>NEW."WindowID"
  AND w."StartsAt"<NEW."StartsAt" AND (w."EndsAt">clock_timestamp() OR w."ResultsFinalizedAt" IS NULL)) THEN
  RAISE EXCEPTION 'Previous round must end and its results must be finalized before opening' USING ERRCODE='23514'; END IF;
IF (NEW."ResultsFinalizedAt" IS NULL)<>(NEW."ResultsFinalizedBy" IS NULL) THEN
  RAISE EXCEPTION 'Finalization actor is required' USING ERRCODE='23514'; END IF;
IF NEW."ResultsFinalizedAt" IS NOT NULL AND (NEW."ResultsEndsAt">clock_timestamp() OR EXISTS(
  SELECT 1 FROM "JobApplications" a JOIN "RecruitmentPosts" p ON p."PostID"=a."PostID"
  WHERE p."WindowID"=NEW."WindowID" AND a."Status" NOT IN ('ACCEPTED','REJECTED','WITHDRAWN'))) THEN
  RAISE EXCEPTION 'Round must end and all application decisions must be completed before finalization' USING ERRCODE='23514'; END IF;
