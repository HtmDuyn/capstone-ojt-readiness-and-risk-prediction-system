      'courseId',mapping."CourseID",'academicPeriodId',mapping."AcademicPeriodID",'gradeBands',mapping."GradeBands")
FROM qhdn_student_ojt_success success
JOIN public."StudentCourseResults" grade ON grade."StudentID"=success."StudentID"
  AND grade."AcademicPeriodID"=success."AcademicPeriodID" AND grade."CourseID"=success."CourseID"
  AND grade."SourceReference"='QHDN_HANDOFF_OJT202_CONFIRMED'
JOIN public."ProgramOJTGradeMappings" mapping ON mapping."ProgramID"=success."ProgramID"
  AND mapping."OJTSemesterID"=success."OJTSemesterID"
JOIN public."Users" academic ON academic."Username"='academic01'
WHERE result."StudentID"=success."StudentID" AND result."OJTSemesterID"=success."OJTSemesterID"
  AND result."Status"='PENDING_ACADEMIC_CONFIRMATION';

INSERT INTO public."OJTRegistrationEvents" ("RegistrationID","Action","IdempotencyKey","Snapshot","CreatedBy","CreatedAt","Reason")
SELECT reg."RegistrationID",'SUBMITTED','QHDN-'||s."StudentCode"||'-SUBMITTED',
