WITH round_summary AS (
  SELECT round_row."WindowID",
    count(application."ApplicationID")::int AS total,
    count(application."ApplicationID") FILTER (WHERE application."Status"='ACCEPTED')::int AS accepted,
    count(application."ApplicationID") FILTER (WHERE application."Status"='REJECTED')::int AS rejected,
    count(application."ApplicationID") FILTER (WHERE application."Status"='WITHDRAWN')::int AS withdrawn,
    count(application."ApplicationID") FILTER (WHERE application."Status" NOT IN ('ACCEPTED','REJECTED','WITHDRAWN'))::int AS pending
  FROM public."RecruitmentWindows" round_row
  LEFT JOIN public."RecruitmentPosts" post ON post."WindowID"=round_row."WindowID"
  LEFT JOIN public."JobApplications" application ON application."PostID"=post."PostID"
  WHERE round_row."CampaignID" IS NOT NULL
  GROUP BY round_row."WindowID"
)
UPDATE public."RecruitmentWindows" round_row
SET "ResultsFinalizedAt"=round_row."ResultsEndsAt","ResultsFinalizedBy"=coordinator."UserID",
  "ResultsSummary"=jsonb_build_object('total',summary.total,'accepted',summary.accepted,'rejected',summary.rejected,
    'withdrawn',summary.withdrawn,'pending',summary.pending)
FROM round_summary summary CROSS JOIN public."Users" coordinator
WHERE round_row."WindowID"=summary."WindowID" AND coordinator."Username"='ojt.coord01'
  AND round_row."ResultsFinalizedAt" IS NULL;

UPDATE public."InternshipPositions" job_position
SET "Status"='CLOSED',"RemainingSlots"=GREATEST(0,job_position."Capacity"-public."RecruitmentOccupiedSlots"(job_position."PositionID"))
WHERE EXISTS (SELECT 1 FROM public."RecruitmentPostPositions" link
  JOIN public."RecruitmentPosts" post ON post."PostID"=link."PostID"
  WHERE link."PositionID"=job_position."PositionID" AND post."SubmissionKey" LIKE 'SEED-RECRUITMENT-%');

