  (CASE s."CohortCode" WHEN 'K21' THEN TIMESTAMP '2026-10-15 09:00:00' ELSE TIMESTAMP '2027-10-15 09:00:00' END)
    +(CASE s."CohortCode" WHEN 'K21' THEN r."Number"-61 ELSE r."Number"-81 END)*INTERVAL '1 day',r."RegistrationStatus",
