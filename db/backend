CREATE OR REPLACE FUNCTION public.invalidate_progress_cache_for_student(p_student_id integer)
RETURNS void LANGUAGE sql AS $$
  UPDATE public."StudentAcademicProgressCache"
  SET "IsDirty"=true,"UpdatedAt"=clock_timestamp()
  WHERE "StudentID"=p_student_id AND NOT "IsDirty";
$$;

CREATE OR REPLACE FUNCTION public.invalidate_progress_cache_for_program(p_program_id integer)
RETURNS void LANGUAGE sql AS $$
  UPDATE public."StudentAcademicProgressCache" cache
  SET "IsDirty"=true,"UpdatedAt"=clock_timestamp()
  FROM public."Students" student
  WHERE cache."StudentID"=student."StudentID" AND student."ProgramID"=p_program_id AND NOT cache."IsDirty";
$$;

CREATE OR REPLACE FUNCTION public.invalidate_student_academic_progress_cache()
RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE
  old_row jsonb := CASE WHEN TG_OP IN ('UPDATE','DELETE') THEN to_jsonb(OLD) ELSE '{}'::jsonb END;
  new_row jsonb := CASE WHEN TG_OP IN ('UPDATE','INSERT') THEN to_jsonb(NEW) ELSE '{}'::jsonb END;
  old_id integer;
  new_id integer;
  program_id integer;
  combo_id integer;
  selection_id integer;
BEGIN
  IF TG_TABLE_NAME IN ('StudentCourseResults','StudentComboSelections') THEN
    old_id := NULLIF(old_row->>'StudentID','')::integer;
    new_id := NULLIF(new_row->>'StudentID','')::integer;
    IF old_id IS NOT NULL THEN PERFORM public.invalidate_progress_cache_for_student(old_id); END IF;
    IF new_id IS NOT NULL AND new_id IS DISTINCT FROM old_id THEN PERFORM public.invalidate_progress_cache_for_student(new_id); END IF;

  ELSIF TG_TABLE_NAME='StudentComboCourseSelections' THEN
    FOREACH selection_id IN ARRAY ARRAY[
      NULLIF(old_row->>'SelectionID','')::integer,
      NULLIF(new_row->>'SelectionID','')::integer
    ] LOOP
      IF selection_id IS NOT NULL THEN
        UPDATE public."StudentAcademicProgressCache" cache
        SET "IsDirty"=true,"UpdatedAt"=clock_timestamp()
        FROM public."StudentComboSelections" selection
        WHERE selection."SelectionID"=selection_id AND cache."StudentID"=selection."StudentID" AND NOT cache."IsDirty";
      END IF;
    END LOOP;

  ELSIF TG_TABLE_NAME='Students' THEN
    new_id := COALESCE(NULLIF(new_row->>'StudentID','')::integer,NULLIF(old_row->>'StudentID','')::integer);
    IF TG_OP='INSERT' THEN
      INSERT INTO public."StudentAcademicProgressCache" ("StudentID","ProgramID","IsDirty")
      VALUES (new_id,NULLIF(new_row->>'ProgramID','')::integer,true)
      ON CONFLICT ("StudentID") DO UPDATE SET "ProgramID"=EXCLUDED."ProgramID","IsDirty"=true,"UpdatedAt"=clock_timestamp();
    ELSIF old_row->>'ProgramID' IS DISTINCT FROM new_row->>'ProgramID' THEN
      INSERT INTO public."StudentAcademicProgressCache" ("StudentID","ProgramID","IsDirty")
      VALUES (new_id,NULLIF(new_row->>'ProgramID','')::integer,true)
      ON CONFLICT ("StudentID") DO UPDATE SET "ProgramID"=EXCLUDED."ProgramID","IsDirty"=true,"UpdatedAt"=clock_timestamp();
    END IF;

  ELSIF TG_TABLE_NAME IN ('TrainingPrograms','AcademicGradingPolicies','ProgramCourses','ProgramCourseEquivalences','ProgramSlotOptions','ProgramCombos') THEN
    FOREACH program_id IN ARRAY ARRAY[
      NULLIF(old_row->>'ProgramID','')::integer,
      NULLIF(new_row->>'ProgramID','')::integer
    ] LOOP
      IF program_id IS NOT NULL THEN PERFORM public.invalidate_progress_cache_for_program(program_id); END IF;
    END LOOP;

  ELSIF TG_TABLE_NAME='ComboCourses' THEN
    FOREACH combo_id IN ARRAY ARRAY[
      NULLIF(old_row->>'ProgramComboID','')::integer,
      NULLIF(new_row->>'ProgramComboID','')::integer
    ] LOOP
      IF combo_id IS NOT NULL THEN
        FOR program_id IN SELECT "ProgramID" FROM public."ProgramCombos" WHERE "ProgramComboID"=combo_id LOOP
          PERFORM public.invalidate_progress_cache_for_program(program_id);
        END LOOP;
      END IF;
    END LOOP;

  ELSIF TG_TABLE_NAME='ComboCourseChoiceGroups' THEN
    FOREACH combo_id IN ARRAY ARRAY[
      NULLIF(old_row->>'ProgramComboID','')::integer,
      NULLIF(new_row->>'ProgramComboID','')::integer
    ] LOOP
      IF combo_id IS NOT NULL THEN
        FOR program_id IN SELECT "ProgramID" FROM public."ProgramCombos" WHERE "ProgramComboID"=combo_id LOOP
          PERFORM public.invalidate_progress_cache_for_program(program_id);
        END LOOP;
      END IF;
    END LOOP;

  ELSIF TG_TABLE_NAME='ComboCourseChoiceMembers' THEN
    FOREACH combo_id IN ARRAY ARRAY[
      NULLIF(old_row->>'ChoiceGroupID','')::integer,
      NULLIF(new_row->>'ChoiceGroupID','')::integer
    ] LOOP
      IF combo_id IS NOT NULL THEN
        FOR program_id IN
          SELECT combo."ProgramID" FROM public."ComboCourseChoiceGroups" choice_group
          JOIN public."ProgramCombos" combo USING ("ProgramComboID")
          WHERE choice_group."ChoiceGroupID"=combo_id
        LOOP
          PERFORM public.invalidate_progress_cache_for_program(program_id);
        END LOOP;
      END IF;
    END LOOP;

  ELSIF TG_TABLE_NAME='Courses' THEN
    FOREACH combo_id IN ARRAY ARRAY[
      NULLIF(old_row->>'CourseID','')::integer,
      NULLIF(new_row->>'CourseID','')::integer
    ] LOOP
      IF combo_id IS NOT NULL THEN
        FOR program_id IN
          SELECT DISTINCT source."ProgramID" FROM (
            SELECT "ProgramID" FROM public."ProgramCourses" WHERE "CourseID"=combo_id
            UNION ALL
            SELECT combo."ProgramID" FROM public."ComboCourses" choice
              JOIN public."ProgramCombos" combo USING ("ProgramComboID")
            WHERE choice."CourseID"=combo_id
          ) source
        LOOP
          PERFORM public.invalidate_progress_cache_for_program(program_id);
        END LOOP;
      END IF;
    END LOOP;

  ELSIF TG_TABLE_NAME='AcademicPeriods' THEN
    FOREACH combo_id IN ARRAY ARRAY[
      NULLIF(old_row->>'AcademicPeriodID','')::integer,
      NULLIF(new_row->>'AcademicPeriodID','')::integer
    ] LOOP
      IF combo_id IS NOT NULL THEN
        UPDATE public."StudentAcademicProgressCache" cache
        SET "IsDirty"=true,"UpdatedAt"=clock_timestamp()
        WHERE cache."StudentID" IN (SELECT result."StudentID" FROM public."StudentCourseResults" result WHERE result."AcademicPeriodID"=combo_id)
          AND NOT cache."IsDirty";
      END IF;
    END LOOP;
  END IF;
  RETURN NULL;
END;
$$;

DO $cache_triggers$
DECLARE table_name text;
BEGIN
  FOREACH table_name IN ARRAY ARRAY[
    'StudentCourseResults','StudentComboSelections','StudentComboCourseSelections','Students',
    'TrainingPrograms','AcademicGradingPolicies','ProgramCourses','ProgramCourseEquivalences',
    'ProgramSlotOptions','ProgramCombos','ComboCourses','ComboCourseChoiceGroups',
    'ComboCourseChoiceMembers','Courses','AcademicPeriods'
  ] LOOP
    EXECUTE format('DROP TRIGGER IF EXISTS "TR_InvalidateStudentProgressCache" ON public.%I',table_name);
    EXECUTE format('CREATE TRIGGER "TR_InvalidateStudentProgressCache" AFTER INSERT OR UPDATE OR DELETE ON public.%I FOR EACH ROW EXECUTE FUNCTION public.invalidate_student_academic_progress_cache()',table_name);
  END LOOP;
END
$cache_triggers$;

