-- Run from the repository root with: psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -f db/backend
-- This is a fresh-build script: it resets and recreates application-owned tables.
BEGIN;
-- Build/reset, schema changes, functions, triggers, and seed data run atomically.
