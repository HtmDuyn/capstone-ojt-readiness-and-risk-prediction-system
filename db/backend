SELECT g.n AS "Number",
  lower(identity."StudentCode") AS "Username",
  g."EmailName"||lower(identity."StudentCode")||'@fpt.edu.vn' AS "Email",
  g."Phone",
  g."FullName",
  identity."StudentCode",
  program."ProgramID",
  cohort."CohortCode",
  CASE WHEN g.n IN (1,2,5,6,9,10) THEN 'ELIGIBLE' END AS "SeedScenario",
  (g.n IN (1,2,5,6,9,10)) AS "CompletedOJT",
  NULL::text AS "RegistrationStatus"
FROM (VALUES
  (1,'Nguyễn Hoàng Minh','minhnh','0902000001'),
  (2,'Lê Thị Ngọc Anh','anhltn','0902000002'),
  (5,'Võ Minh Khang','khangvm','0902000003'),
  (6,'Đặng Tuấn Kiệt','kietdt','0902000004'),
  (9,'Nguyễn Thị Mai Chi','chintm','0902000005'),
  (10,'Hoàng Đức Anh','anhhd','0902000006'),
  (13,'Trương Hải Đăng','dangth','0902000007'),
  (14,'Lý Khánh Vy','vylk','0902000008'),
  (17,'Nguyễn Văn Hùng','hungnv','0902000009'),
  (18,'Trần Ngọc Linh','linhtn','0902000010'),
  (21,'Phạm Gia Bảo','baopg','0902000011'),
  (22,'Đỗ Minh Thư','thudm','0902000012'),
  (81,'Đinh Minh Hoàng','hoangdm','0902000013'),
  (82,'Hồ Khánh Ngọc','ngochk','0902000014'),
  (83,'Lý Quốc Cường','cuonglq','0902000015'),
  (84,'Trịnh Thanh Hà','hatt','0902000016'),
  (41,'Phan Quốc Bảo','baopq','0902000021'),
  (42,'Lê Gia Hân','hanlg','0902000022'),
  (43,'Nguyễn Tấn Phát','phatnt','0902000023'),
  (44,'Đỗ Thùy Linh','linhdt','0902000024')) AS g(n,"FullName","EmailName","Phone")
JOIN LATERAL (
  SELECT CASE ((g.n-1)/20)
    WHEN 0 THEN 'K18' WHEN 1 THEN 'K19' WHEN 2 THEN 'K20' WHEN 3 THEN 'K21' ELSE 'K22' END AS "CohortCode",
    CASE WHEN g.n IN (41,44) THEN 'IS' WHEN g.n IN (42,43) THEN 'SE'
      ELSE CASE ((g.n-1)%4) WHEN 0 THEN 'IS' WHEN 1 THEN 'SE' WHEN 2 THEN 'AI' ELSE 'IA' END END AS "MajorCode"
) assignment ON true
JOIN public."TrainingPrograms" program ON program."Status"='PUBLISHED' AND program."ProgramCode"=CASE assignment."MajorCode"
  WHEN 'AI' THEN CASE assignment."CohortCode" WHEN 'K18' THEN 'BIT_AI_K18D-19A' WHEN 'K19' THEN 'BIT_AI_K19D-20A'
    WHEN 'K20' THEN 'BIT_AI_K20D-21A' ELSE 'BIT_AI_K21D-22A' END
  WHEN 'IA' THEN CASE assignment."CohortCode" WHEN 'K18' THEN 'BIT_IA_K18D-19A' WHEN 'K19' THEN 'BIT_IA_K19D-20A'
    WHEN 'K20' THEN 'BIT_IA_K20D-21A' ELSE 'BIT_IA_K21D-22A' END
  WHEN 'IS' THEN CASE assignment."CohortCode" WHEN 'K18' THEN 'BIT_IS_K18D_19A' WHEN 'K19' THEN 'BIT_IS_K19D_K20A'
    WHEN 'K20' THEN 'BIT_IS_K20D-21A' WHEN 'K21' THEN 'BIT_IS_K20D-21A' ELSE 'BIT_SE-2026_K21D_K22A' END
  ELSE CASE assignment."CohortCode" WHEN 'K18' THEN 'BIT_SE_K18D_19A' WHEN 'K19' THEN 'BIT_SE_K19D_K20A'
    WHEN 'K20' THEN 'BIT_SE_K20D_K21A' ELSE 'BIT_SE-2026_K21D_K22A' END
END
CROSS JOIN LATERAL (
  SELECT public."CurriculumCohortCodes"(program."ProgramCode") AS "CohortCodes"
) curriculum
CROSS JOIN LATERAL (SELECT assignment."CohortCode") cohort
CROSS JOIN LATERAL (
  SELECT substring(program."ProgramCode" FROM '^BIT_([A-Z]{2})')
    || substring(cohort."CohortCode" FROM 2)
    || (1600+g.n)::text AS "StudentCode"
) identity;

