SET LOCAL lock_timeout='60s';
SET LOCAL search_path=public,pg_catalog;
SET LOCAL TIME ZONE 'Asia/Ho_Chi_Minh';
SELECT pg_advisory_xact_lock(hashtext('ojt_full_fresh_build_20261121'));

DROP SCHEMA IF EXISTS ojt_history CASCADE;

-- Reset only the application tables owned by this OJT system. All existing rows in these tables are removed.
DO $reset_ojt_tables$
