CREATE OR REPLACE FUNCTION public."ExpireRecruitmentResponses"() RETURNS integer
LANGUAGE plpgsql SET search_path=public,pg_catalog AS $$
DECLARE application record; rejected_count integer:=0;
reason text:='Doanh nghiệp từ chối: quá hạn phản hồi của đợt tuyển dụng.';
BEGIN
PERFORM pg_advisory_xact_lock(hashtext('academic-calendar'));
FOR application IN
  UPDATE "JobApplications" a SET "Status"='REJECTED',"ReviewNote"=reason,"ReviewedBy"=w."CreatedBy","UpdatedAt"=now()
  FROM "RecruitmentPosts" p JOIN "RecruitmentWindows" w ON w."WindowID"=p."WindowID"
  WHERE a."PostID"=p."PostID" AND w."CampaignID" IS NOT NULL
  AND w."ResultsEndsAt" IS NOT NULL AND w."ResultsEndsAt"<=clock_timestamp()
  AND a."Status" NOT IN ('ACCEPTED','REJECTED','WITHDRAWN')
  AND NOT EXISTS(SELECT 1 FROM "StudentEnterpriseCoordination" co JOIN "InternshipAssignments" ia USING("CoordinationID")
    WHERE co."ApplicationID"=a."ApplicationID" AND COALESCE(upper(ia."Status"),'ASSIGNED') NOT IN ('CANCELLED','CANCELED'))
  RETURNING a.*,w."WindowID",w."CreatedBy" AS actor_id,w."ResultsEndsAt"
LOOP
  UPDATE "StudentEnterpriseCoordination" SET "Decision"='REJECTED',"DecisionAt"=clock_timestamp(),"RejectReason"=reason
  WHERE "ApplicationID"=application."ApplicationID" AND "Decision"='PENDING';
  INSERT INTO "ApplicationEvents" ("ApplicationID","Action","ActorID","Reason","Snapshot")
  VALUES(application."ApplicationID",'AUTO_REJECT_RESPONSE_DEADLINE',application.actor_id,reason,
    jsonb_build_object('system',true,'status','REJECTED','windowId',application."WindowID",'deadlineAt',application."ResultsEndsAt",'qhdnFollowUp',true));
  rejected_count:=rejected_count+1;
END LOOP;
UPDATE "OJTRegistrationWindows" SET "Status"='CLOSED',"UpdatedAt"=now()
  WHERE "RecruitmentRoundID" IS NOT NULL AND "Status"='OPEN' AND "EndsAt"<=clock_timestamp();
RETURN rejected_count;
END $$;
REVOKE ALL ON FUNCTION public."ExpireRecruitmentResponses"() FROM PUBLIC;
DO $permissions$ BEGIN
IF EXISTS(SELECT 1 FROM pg_roles WHERE rolname='service_role') THEN
  GRANT EXECUTE ON FUNCTION public."ExpireRecruitmentResponses"() TO service_role;
END IF;
END $permissions$;

CREATE OR REPLACE FUNCTION public."AdvanceEnterpriseRecruitment"() RETURNS integer
LANGUAGE plpgsql SET search_path=public AS $$
DECLARE post_row record; continued integer:=0;
BEGIN
PERFORM pg_advisory_xact_lock(hashtext('academic-calendar'));
FOR post_row IN
  SELECT p."PostID",p."CreatedBy",p."WindowID" AS previous_window,next_window."WindowID" AS next_window,
  public."EnterpriseRecruitmentDeadline"(p."OJTSemesterID") AS deadline
  FROM "RecruitmentPosts" p
  JOIN "RecruitmentWindows" old_window ON old_window."WindowID"=p."WindowID"
  JOIN "AcademicPeriods" ap ON ap."AcademicPeriodID"=old_window."AcademicPeriodID"
  JOIN "OJTSemesters" semester ON semester."OJTSemesterID"=p."OJTSemesterID" AND semester."AcademicPeriodID"=ap."AcademicPeriodID"
  JOIN "Enterprises" e ON e."EnterpriseID"=p."EnterpriseID" AND e."Status"='ACTIVE' AND e."DeletedAt" IS NULL
  JOIN LATERAL (
  SELECT w."WindowID",w."EndsAt" FROM "RecruitmentWindows" w
  WHERE w."OJTSemesterID"=p."OJTSemesterID" AND w."AcademicPeriodID"=ap."AcademicPeriodID"
    AND w."WindowID"<>p."WindowID" AND w."Status"='OPEN' AND w."ResultsStartsAt" IS NULL
    AND w."StartsAt">=old_window."EndsAt" AND w."StartsAt"<=clock_timestamp() AND w."EndsAt">clock_timestamp()
  ORDER BY w."StartsAt",w."WindowID" LIMIT 1
  ) next_window ON true
  WHERE p."EnterpriseManaged" AND p."ArchivedAt" IS NULL AND old_window."ResultsStartsAt" IS NULL
  AND (p."Status"='PUBLISHED' OR (p."Status"='CLOSED' AND (p."ReviewedAt" IS NULL OR p."ReviewedAt"=p."PublishedAt")))
  AND p."PublishedAt" IS NOT NULL
  AND old_window."EndsAt"<=clock_timestamp() AND ap."Kind"='SEMESTER' AND ap."Status" NOT IN ('CLOSED','ARCHIVED')
  AND (ap."EndDate"+1)::timestamp AT TIME ZONE 'Asia/Ho_Chi_Minh'>clock_timestamp()
  AND NOT EXISTS(SELECT 1 FROM "OJTRegistrationWindows" rw WHERE rw."OJTSemesterID"=p."OJTSemesterID"
    AND rw."Status"='OPEN' AND rw."StartsAt"<=clock_timestamp() AND rw."EndsAt">clock_timestamp())
  AND EXISTS(SELECT 1 FROM "RecruitmentPostPositions" pp JOIN "InternshipPositions" pos USING("PositionID")
    WHERE pp."PostID"=p."PostID" AND pos."DeletedAt" IS NULL AND pos."ArchivedAt" IS NULL
    AND pos."Status" IN ('OPEN','CLOSED') AND pos."Capacity">(SELECT count(*) FROM "InternshipAssignments" a
      WHERE a."PositionID"=pos."PositionID" AND COALESCE(upper(a."Status"),'ASSIGNED') NOT IN ('CANCELLED','CANCELED')))
  FOR UPDATE OF p
LOOP
  UPDATE "RecruitmentPosts" SET "WindowID"=post_row.next_window,"DeadlineAt"=post_row.deadline,"Status"='PUBLISHED',"UpdatedAt"=now()
  WHERE "PostID"=post_row."PostID";
  UPDATE "InternshipPositions" pos SET "Status"='OPEN'
  FROM "RecruitmentPostPositions" pp WHERE pp."PostID"=post_row."PostID" AND pp."PositionID"=pos."PositionID"
    AND pos."Status"='CLOSED' AND pos."DeletedAt" IS NULL AND pos."ArchivedAt" IS NULL;
  INSERT INTO "AuditLogs" ("UserID","Action","EntityType","EntityID","Detail")
  VALUES(post_row."CreatedBy",'ENTERPRISE_AUTO_CONTINUE','RecruitmentPosts',post_row."PostID",
    jsonb_build_object('system',true,'before',jsonb_build_object('windowId',post_row.previous_window),
    'after',jsonb_build_object('windowId',post_row.next_window,'deadlineAt',post_row.deadline))::text);
  continued:=continued+1;
END LOOP;
RETURN continued;
END $$;

