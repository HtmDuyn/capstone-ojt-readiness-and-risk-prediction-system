SELECT reg."RegistrationID",r."RegistrationStatus",'QHDN-'||s."StudentCode"||'-REVIEWED',
  jsonb_build_object('source','QHDN_HANDOFF','studentCode',s."StudentCode",'status',r."RegistrationStatus"),coordinator."UserID",
