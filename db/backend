INSERT INTO public."OJTRegistrations" ("StudentID","OJTSemesterID","RegisteredAt","Status","WindowID","ProgramID","Application","SubmittedBy","ReviewCheckID","ReviewedBy","ReviewedAt","ReviewReason")
