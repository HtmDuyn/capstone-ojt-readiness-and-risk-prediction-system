  schedule."ApplicationEndsAt",schedule."ResultsStartsAt",schedule."ResultsEndsAt",schedule."PostingStartsAt"
FROM qhdn_seed_recruitment_schedule schedule
JOIN public."RecruitmentCampaigns" campaign ON campaign."OJTSemesterID"=schedule."OJTSemesterID"
CROSS JOIN public."Users" coordinator
WHERE coordinator."Username"='ojt.coord01'
