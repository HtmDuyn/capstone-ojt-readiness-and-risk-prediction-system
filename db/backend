-- Attach the completed K18 students to the TechViet recruitment application and position records.
INSERT INTO public."JobApplications"
  ("RegistrationID","StudentID","OJTSemesterID","PostID","PositionID","EnterpriseID","Status","AppliedAt","UpdatedAt",
   "ReviewedBy","ReviewNote","PositionSnapshot","ApplicationSnapshot")
SELECT success."RegistrationID",success."StudentID",success."OJTSemesterID",post."PostID",job_position."PositionID",
  enterprise."EnterpriseID",'ACCEPTED',schedule."ApplicationStartsAt"+INTERVAL '1 day',
  schedule."ResultsStartsAt"+INTERVAL '3 days',enterprise_user."UserID",
