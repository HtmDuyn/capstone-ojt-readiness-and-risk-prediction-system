USING public."Courses" course,public."AcademicPeriods" period
WHERE enrollment."CourseID"=course."CourseID" AND enrollment."AcademicPeriodID"=period."AcademicPeriodID"
  AND enrollment."SourceReference"='AUTO_OJT_ENROLLMENT' AND enrollment."Status"='IN_PROGRESS'
  AND upper(btrim(course."CourseCode"))='OJT202'
  AND NOT EXISTS (
    SELECT 1 FROM public."OJTRegistrations" registration
    JOIN public."OJTSemesters" term USING ("OJTSemesterID")
    JOIN public."AcademicPeriods" target ON target."AcademicPeriodID"=term."AcademicPeriodID"
