-- Preserve course enrollment for students who already submitted an OJT registration.
INSERT INTO public."StudentCourseResults"
  ("StudentID","CourseID","SemesterTaken","AcademicYearID","Status","AcademicPeriodID","AttemptNumber","SourceReference","RecordedBy")
SELECT registration."StudentID",pc."CourseID",6,period."AcademicYearID",'IN_PROGRESS',period."AcademicPeriodID",
  COALESCE((SELECT max(previous."AttemptNumber") FROM public."StudentCourseResults" previous
    JOIN public."AcademicPeriods" previous_period ON previous_period."AcademicPeriodID"=previous."AcademicPeriodID"
    JOIN public."Courses" previous_course ON previous_course."CourseID"=previous."CourseID"
    WHERE previous."StudentID"=registration."StudentID" AND upper(btrim(previous_course."CourseCode"))='OJT202'
      AND COALESCE(previous_period."ParentPeriodID",previous_period."AcademicPeriodID")=period."AcademicPeriodID"),0)+1,
  'AUTO_OJT_ENROLLMENT',registration."SubmittedBy"
FROM public."OJTRegistrations" registration
JOIN public."Students" student USING ("StudentID")
JOIN public."OJTSemesters" term USING ("OJTSemesterID")
JOIN public."AcademicPeriods" period ON period."AcademicPeriodID"=term."AcademicPeriodID"
JOIN public."ProgramCourses" pc ON pc."ProgramID"=student."ProgramID" AND pc."EntryKind"='COURSE' AND pc."RecommendedSemester"=6
JOIN public."Courses" course ON course."CourseID"=pc."CourseID" AND upper(btrim(course."CourseCode"))='OJT202'
WHERE period."Kind"='SEMESTER'
  AND NOT EXISTS (SELECT 1 FROM public."StudentCourseResults" passed JOIN public."Courses" passed_course USING ("CourseID")
    WHERE passed."StudentID"=registration."StudentID" AND upper(btrim(passed_course."CourseCode"))='OJT202' AND passed."Status"='PASSED')
  AND NOT EXISTS (SELECT 1 FROM public."StudentCourseResults" existing
    JOIN public."AcademicPeriods" existing_period ON existing_period."AcademicPeriodID"=existing."AcademicPeriodID"
    JOIN public."Courses" existing_course ON existing_course."CourseID"=existing."CourseID"
    WHERE existing."StudentID"=registration."StudentID" AND upper(btrim(existing_course."CourseCode"))='OJT202'
      AND COALESCE(existing_period."ParentPeriodID",existing_period."AcademicPeriodID")=period."AcademicPeriodID")
ON CONFLICT ("StudentID","CourseID","AcademicPeriodID","AttemptNumber")
  WHERE "AcademicPeriodID" IS NOT NULL DO NOTHING;


-- BEGIN OJT202 ELIGIBILITY GATE V1 (20261127)
-- Existing databases can apply this block; the full db/backend script rebuilds the database.
SET LOCAL lock_timeout='5s';
SELECT pg_advisory_xact_lock(hashtext('academic-calendar'));

-- Correct persisted eligibility decisions made before OJT202 completion was
-- included in the recruitment rule.
UPDATE public."StudentOJTCalculatedResults" saved
SET "Status"='NOT_ELIGIBLE',
    "CheckedAt"=clock_timestamp(),
    "SavedAt"=clock_timestamp(),
    "Result"=jsonb_set(
      jsonb_set(
        jsonb_set(saved."Result",'{status}','"NOT_ELIGIBLE"'::jsonb,true),
        '{checkedAt}',to_jsonb(clock_timestamp()),true),
      '{reasons}',
      CASE WHEN COALESCE(saved."Result"->'reasons','[]'::jsonb)
        @> '["Đã đạt môn OJT202 nên không còn thuộc danh sách xét đợt OJT."]'::jsonb
        THEN COALESCE(saved."Result"->'reasons','[]'::jsonb)
        ELSE COALESCE(saved."Result"->'reasons','[]'::jsonb) ||
          '["Đã đạt môn OJT202 nên không còn thuộc danh sách xét đợt OJT."]'::jsonb
      END,
      true
    )
WHERE saved."Status"='ELIGIBLE'
  AND EXISTS (
    SELECT 1 FROM public."StudentCourseResults" grade
    JOIN public."Courses" course USING ("CourseID")
    WHERE grade."StudentID"=saved."StudentID"
      AND upper(btrim(course."CourseCode"))='OJT202'
      AND grade."Status"='PASSED'
  );

CREATE OR REPLACE VIEW public."OJTRecruitmentRoster" WITH (security_invoker=true) AS
SELECT s."StudentID", target."OJTSemesterID", round."WindowID" AS "RoundID",
  round."Name" AS "RoundName", saved."BatchID", saved."CheckedAt"
FROM public."Students" s
JOIN public."Users" u ON u."UserID"=s."UserID"
JOIN public."StudentOJTCalculatedResults" saved USING ("StudentID")
LEFT JOIN public."OJTSemesters" target
  ON target."AcademicPeriodID"=public."DefaultOJTAcademicPeriod"(s."StudentID")
LEFT JOIN LATERAL (
  SELECT w."WindowID",w."Name"
  FROM public."RecruitmentWindows" w
  WHERE w."OJTSemesterID"=target."OJTSemesterID"
    AND target."Status" NOT IN ('CLOSED','ARCHIVED')
    AND EXISTS (
      SELECT 1 FROM public."ProgramCourses" pc
      JOIN public."Courses" c USING ("CourseID")
      JOIN public."TrainingPrograms" program USING ("ProgramID")
      WHERE pc."ProgramID"=s."ProgramID" AND program."Status"='PUBLISHED'
        AND upper(btrim(c."CourseCode"))='OJT202' AND pc."EntryKind"='COURSE'
        AND pc."RecommendedSemester"=6
    )
    AND w."Status"='OPEN' AND w."ResultsFinalizedAt" IS NULL
    AND w."EndsAt">statement_timestamp()
    AND COALESCE(w."ApplicationEndsAt",w."EndsAt")>statement_timestamp()
  ORDER BY COALESCE(w."ApplicationStartsAt",w."StartsAt"),w."WindowID"
  LIMIT 1
) round ON true
WHERE saved."Status"='ELIGIBLE'
  AND s."Status"='ACTIVE' AND u."Status"='ACTIVE' AND s."DeletedAt" IS NULL
  AND saved."ProgramID" IS NOT DISTINCT FROM s."ProgramID"
  AND CASE WHEN saved."ConditionID" IS NOT NULL THEN
    saved."ConditionID" IS NOT DISTINCT FROM (saved."Result"->'rule'->>'conditionId')::int
    AND saved."ConditionID" IS NOT DISTINCT FROM (
      SELECT condition."ConditionID" FROM public."OJTConditions" condition
      WHERE condition."EffectiveFrom"<=(statement_timestamp() AT TIME ZONE 'Asia/Ho_Chi_Minh')::date
      ORDER BY condition."EffectiveFrom" DESC,condition."Version" DESC LIMIT 1
    )
    ELSE CASE WHEN COALESCE(saved."Result"->'rule'->'defaultRule','false'::jsonb)='true'::jsonb THEN NOT EXISTS (
      SELECT 1 FROM public."OJTConditions" condition
      WHERE condition."EffectiveFrom"<=(statement_timestamp() AT TIME ZONE 'Asia/Ho_Chi_Minh')::date
    ) ELSE COALESCE((saved."Result"->>'policyVersion')::int,0)=COALESCE(
      (SELECT max(policy."Version") FROM public."OJTConditionPolicies" policy),0
    ) END
  END
  AND NOT EXISTS (
    SELECT 1 FROM public."StudentAcademicPlacements" placement
    WHERE placement."StudentID"=s."StudentID" AND placement."UpdatedAt">saved."CheckedAt"
  )
  AND NOT EXISTS (
    SELECT 1 FROM public."StudentCourseResults" history
    WHERE history."StudentID"=s."StudentID"
      AND COALESCE(history."UpdatedAt",history."CreatedAt")>saved."CheckedAt"
      AND (history."SourceReference" IS DISTINCT FROM 'AUTO_OJT_ENROLLMENT'
        OR history."Status" IS DISTINCT FROM 'IN_PROGRESS')
  )
  AND NOT EXISTS (
    SELECT 1 FROM public."StudentCourseResults" grade
    JOIN public."Courses" course USING ("CourseID")
    WHERE grade."StudentID"=s."StudentID"
      AND upper(btrim(course."CourseCode"))='OJT202'
      AND grade."Status"='PASSED'
  )
UNION
SELECT registration."StudentID",registration."OJTSemesterID",recruitment_round."WindowID",
  recruitment_round."Name",NULL::integer,registration."ReviewedAt"
FROM public."OJTRegistrations" registration
JOIN public."StudentEnterpriseCoordination" coordination
  ON coordination."RegistrationID"=registration."RegistrationID"
 AND coordination."Decision" IN ('ACCEPTED','APPROVED')
JOIN public."InternshipAssignments" assignment
  ON assignment."CoordinationID"=coordination."CoordinationID"
 AND assignment."Status"='COMPLETED'
JOIN LATERAL (
  SELECT post."WindowID"
  FROM public."JobApplications" application
  JOIN public."RecruitmentPosts" post ON post."PostID"=application."PostID"
  WHERE application."RegistrationID"=registration."RegistrationID"
    AND application."PositionID"=assignment."PositionID"
    AND application."Status"='ACCEPTED'
  ORDER BY application."UpdatedAt" DESC,application."ApplicationID" DESC
  LIMIT 1
) accepted_application ON true
JOIN public."RecruitmentWindows" recruitment_round
  ON recruitment_round."WindowID"=accepted_application."WindowID"
 AND recruitment_round."OJTSemesterID"=registration."OJTSemesterID"
WHERE registration."Status"='APPROVED';


