-- Give each seeded company a matching position for every OJT semester; reuse TechViet's completed-OJT positions.
INSERT INTO public."InternshipPositions"
  ("EnterpriseID","OJTSemesterID","Title","Description","Requirements","Capacity","RemainingSlots","Status","Location","WorkMode","RecruitmentCode")
SELECT enterprise."EnterpriseID",schedule."OJTSemesterID",
  CASE enterprise."EnterpriseCode" WHEN 'DATAVIT' THEN 'Thực tập sinh phân tích dữ liệu'
    WHEN 'SAIGONSOFT' THEN 'Thực tập sinh phát triển phần mềm'
    WHEN 'FINNEXT' THEN 'Thực tập sinh phát triển ứng dụng tài chính'
    ELSE 'Thực tập sinh phát triển phần mềm' END,
  'Tham gia dự án thực tế, làm việc cùng đội ngũ hướng dẫn tại doanh nghiệp.',
  'Sinh viên đủ điều kiện OJT, có kiến thức lập trình cơ bản và tinh thần học hỏi.',6,6,'CLOSED',
  'TP. Hồ Chí Minh','HYBRID','SEED-JOB-'||schedule."PeriodCode"||'-'||enterprise."EnterpriseCode"
FROM qhdn_seed_recruitment_schedule schedule
CROSS JOIN public."Enterprises" enterprise
WHERE enterprise."EnterpriseCode" IN ('TECHVIET','DATAVIT','SAIGONSOFT','FINNEXT')
  AND NOT (enterprise."EnterpriseCode"='TECHVIET' AND schedule."PeriodCode" IN ('SPRING2024','SPRING2025','SPRING2026'))
  AND NOT EXISTS (SELECT 1 FROM public."InternshipPositions" existing
    WHERE existing."EnterpriseID"=enterprise."EnterpriseID" AND existing."OJTSemesterID"=schedule."OJTSemesterID"
      AND existing."RecruitmentCode"='SEED-JOB-'||schedule."PeriodCode"||'-'||enterprise."EnterpriseCode");

INSERT INTO public."RecruitmentPosts"
  ("EnterpriseID","OJTSemesterID","WindowID","Title","Content","Benefits","ApplicationInstructions","Status",
   "PublishedAt","DeadlineAt","CreatedBy","CreatedAt","UpdatedAt","SubmissionKey","EnterpriseManaged")
SELECT enterprise."EnterpriseID",schedule."OJTSemesterID",round_row."WindowID",
  job_position."Title"||' - '||schedule."PeriodName",
  'Cơ hội thực tập OJT có hướng dẫn tại doanh nghiệp. Sinh viên tham gia công việc chuyên môn, phối hợp với nhóm dự án và hoàn thành nhiệm vụ theo kế hoạch thực tập.',
  'Có người hướng dẫn, môi trường làm việc thực tế và xác nhận kết quả thực tập theo quy định của chương trình.',
  'Nộp hồ sơ OJT trên hệ thống và chuẩn bị CV cùng thông tin liên hệ cập nhật.',
  'CLOSED',schedule."PostingStartsAt",schedule."ApplicationEndsAt",account."UserID",
  schedule."PostingStartsAt"-INTERVAL '1 day',schedule."ResultsEndsAt",
