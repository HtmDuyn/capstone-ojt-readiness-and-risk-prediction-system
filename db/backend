    'requirements',job_position."Requirements",'capacity',job_position."Capacity",'location',job_position."Location",
    'workMode',job_position."WorkMode",'postId',post."PostID",'deadlineAt',post."DeadlineAt"),
  jsonb_build_object('application',jsonb_build_object('contactPhone',student_user."Phone",'contactEmail',student_user."Email",
      'note','Hồ sơ ứng tuyển OJT mẫu.'),
    'position',to_jsonb(job_position)||jsonb_build_object('PostEnterpriseID',enterprise."EnterpriseID",
      'PostStatus',post."Status",'PostWindowID',post."WindowID",'DeadlineAt',post."DeadlineAt",'CompanyStatus',enterprise."Status"),
    'post',jsonb_build_object('id',post."PostID",'windowId',post."WindowID"),
    'coverLetter','Em mong muốn tham gia thực tập và hoàn thành các mục tiêu OJT tại doanh nghiệp.',
    'certificates','[]'::jsonb,'cvFileId',NULL)
FROM qhdn_student_ojt_success success
JOIN public."Students" student ON student."StudentID"=success."StudentID"
JOIN public."Users" student_user ON student_user."UserID"=student."UserID"
JOIN public."AcademicPeriods" period ON period."AcademicPeriodID"=success."AcademicPeriodID"
JOIN qhdn_seed_recruitment_schedule schedule ON schedule."OJTSemesterID"=success."OJTSemesterID"
JOIN public."Enterprises" enterprise ON enterprise."EnterpriseCode"='TECHVIET'
JOIN public."EnterpriseUsers" membership ON membership."EnterpriseID"=enterprise."EnterpriseID"
JOIN public."Users" enterprise_user ON enterprise_user."UserID"=membership."UserID"
JOIN public."RecruitmentPosts" post ON post."SubmissionKey"='SEED-RECRUITMENT-'||period."PeriodCode"||'-TECHVIET'
JOIN public."RecruitmentPostPositions" post_position ON post_position."PostID"=post."PostID"
JOIN public."InternshipPositions" job_position ON job_position."PositionID"=post_position."PositionID"
WHERE NOT EXISTS (SELECT 1 FROM public."JobApplications" existing
  WHERE existing."RegistrationID"=success."RegistrationID" AND existing."PostID"=post."PostID"
