-- Link the completed students' registrations to the registration window for the actual recruitment round.
UPDATE public."OJTRegistrations" registration
SET "WindowID"=round_window."WindowID"
FROM qhdn_student_ojt_success success
JOIN public."OJTRegistrationWindows" round_window
  ON round_window."OJTSemesterID"=success."OJTSemesterID"
 AND round_window."RecruitmentRoundID" IS NOT NULL
