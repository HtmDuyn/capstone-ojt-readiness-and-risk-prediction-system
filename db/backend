    WHERE "PeriodCode"=CASE s."CohortCode" WHEN 'K21' THEN 'SPRING2027' ELSE 'SPRING2028' END)
CROSS JOIN public."Users" coordinator
WHERE r."RegistrationStatus" IN ('APPROVED','REJECTED') AND coordinator."Username"='ojt.coord01'
ON CONFLICT ("RegistrationID","IdempotencyKey") DO NOTHING;

DO $verify_qhdn_seed_students$
BEGIN
  IF (SELECT count(*) FROM public."Students" s JOIN public."Users" u USING ("UserID")
      JOIN qhdn_student_roster roster ON roster."StudentCode"=s."StudentCode" AND roster."Email"=u."Email")<>20 THEN
    RAISE EXCEPTION 'Expected 20 QHDN seed students.';
  END IF;
  IF (SELECT count(*) FROM public."AcademicPeriods" WHERE "PeriodCode" ~ '^(SPRING|SUMMER|FALL)202[2-9]$')<>24 THEN
    RAISE EXCEPTION 'Expected Spring, Summer and Fall periods for academic years 2022-2023 through 2029-2030.';
  END IF;
  IF (SELECT count(*) FROM public."CohortGroups" group_row JOIN public."Cohorts" cohort USING ("CohortID")
      WHERE cohort."CohortCode" IN ('K18','K19','K20','K21','K22'))<>20 THEN
    RAISE EXCEPTION 'Each cohort must have the source-defined A-D groups.';
  END IF;
  IF (SELECT count(*) FROM public."OJTRegistrations" r JOIN public."OJTSemesters" term USING ("OJTSemesterID")
      JOIN public."AcademicPeriods" period ON period."AcademicPeriodID"=term."AcademicPeriodID"
      WHERE period."PeriodCode" IN ('SPRING2027','SPRING2028'))<>0 THEN
    RAISE EXCEPTION 'Expected no OJT registrations before the seeded eligibility assessment runs.';
  END IF;
  IF (SELECT count(*) FROM qhdn_student_ojt_success)<>
       (SELECT count(*) FROM qhdn_student_roster WHERE "CompletedOJT")
    OR (SELECT count(*) FROM public."OJTResults" result JOIN qhdn_student_ojt_success success
        ON success."StudentID"=result."StudentID" AND success."OJTSemesterID"=result."OJTSemesterID"
        WHERE result."Status"='CONFIRMED' AND result."OfficialScore"=8.50 AND result."Outcome"='PASSED') <>
       (SELECT count(*) FROM qhdn_student_ojt_success)
    OR (SELECT count(*) FROM public."StudentCourseResults" grade JOIN qhdn_student_ojt_success success
        ON success."StudentID"=grade."StudentID" AND success."AcademicPeriodID"=grade."AcademicPeriodID"
        WHERE grade."CourseID"=success."CourseID" AND grade."SemesterTaken"=6 AND grade."Status"='PASSED'
          AND grade."SourceReference"='QHDN_HANDOFF_OJT202_CONFIRMED') <>
       (SELECT count(*) FROM qhdn_student_ojt_success)
    OR (SELECT count(*) FROM public."OJTActualReceipts" receipt JOIN qhdn_student_ojt_success success
        ON success."StudentID"=receipt."StudentID" AND success."OJTSemesterID"=receipt."OJTSemesterID") <>
       (SELECT count(*) FROM qhdn_student_ojt_success) THEN
    RAISE EXCEPTION 'Every roster student marked completed must have a joined assignment, confirmed passing score, and passed OJT202 transcript record.';
  END IF;
  IF (SELECT count(*) FROM qhdn_student_ojt_success success
      JOIN public."StudentEnterpriseCoordination" coordination ON coordination."RegistrationID"=success."RegistrationID" AND coordination."Decision"='ACCEPTED'
      JOIN public."InternshipAssignments" assignment ON assignment."CoordinationID"=coordination."CoordinationID"
      JOIN public."InternshipTasks" task ON task."AssignmentID"=assignment."AssignmentID" AND task."TaskName" LIKE 'OJT mẫu:%') <>
      (SELECT count(*) FROM qhdn_student_ojt_success success
       JOIN public."StudentEnterpriseCoordination" coordination ON coordination."RegistrationID"=success."RegistrationID" AND coordination."Decision"='ACCEPTED'
       JOIN public."InternshipAssignments" assignment ON assignment."CoordinationID"=coordination."CoordinationID")
    OR (SELECT count(*) FROM qhdn_student_ojt_success success
      JOIN public."StudentEnterpriseCoordination" coordination ON coordination."RegistrationID"=success."RegistrationID" AND coordination."Decision"='ACCEPTED'
      JOIN public."InternshipAssignments" assignment ON assignment."CoordinationID"=coordination."CoordinationID"
      JOIN public."InternshipTasks" task ON task."AssignmentID"=assignment."AssignmentID" AND task."TaskName" LIKE 'OJT mẫu:%'
      JOIN public."TaskProgressUpdates" progress ON progress."TaskID"=task."TaskID"
        AND progress."UpdatedByStudentID"=success."StudentID" AND progress."PercentComplete"=100) <>
      (SELECT count(*) FROM qhdn_student_ojt_success success
       JOIN public."StudentEnterpriseCoordination" coordination ON coordination."RegistrationID"=success."RegistrationID" AND coordination."Decision"='ACCEPTED'
       JOIN public."InternshipAssignments" assignment ON assignment."CoordinationID"=coordination."CoordinationID")
    OR (SELECT count(*) FROM qhdn_student_ojt_success success
      JOIN public."StudentEnterpriseCoordination" coordination ON coordination."RegistrationID"=success."RegistrationID" AND coordination."Decision"='ACCEPTED'
      JOIN public."InternshipAssignments" assignment ON assignment."CoordinationID"=coordination."CoordinationID"
      JOIN public."InternshipEvaluations" evaluation ON evaluation."AssignmentID"=assignment."AssignmentID"
        AND evaluation."Status"='SUBMITTED' AND evaluation."OverallScore"=8.50) <>
      (SELECT count(*) FROM qhdn_student_ojt_success success
       JOIN public."StudentEnterpriseCoordination" coordination ON coordination."RegistrationID"=success."RegistrationID" AND coordination."Decision"='ACCEPTED'
       JOIN public."InternshipAssignments" assignment ON assignment."CoordinationID"=coordination."CoordinationID")
    OR (SELECT count(*) FROM public."Notifications" publication
      JOIN public."InternshipEvaluations" evaluation ON evaluation."EvaluationID"=publication."RelatedEntityID"
      JOIN public."InternshipAssignments" assignment ON assignment."AssignmentID"=evaluation."AssignmentID"
      JOIN public."StudentEnterpriseCoordination" coordination ON coordination."CoordinationID"=assignment."CoordinationID"
      JOIN qhdn_student_ojt_success success ON success."RegistrationID"=coordination."RegistrationID"
      WHERE publication."RelatedEntityType"='OJT_RESULT_PUBLISHED') <>
      (SELECT count(*) FROM qhdn_student_ojt_success success
       JOIN public."StudentEnterpriseCoordination" coordination ON coordination."RegistrationID"=success."RegistrationID" AND coordination."Decision"='ACCEPTED'
       JOIN public."InternshipAssignments" assignment ON assignment."CoordinationID"=coordination."CoordinationID") THEN
    RAISE EXCEPTION 'Expected each completed OJT assignment to include one student-completed task and a published enterprise evaluation.';
  END IF;
  IF (SELECT count(*) FROM qhdn_student_roster)<>20
    OR (SELECT count(*) FROM qhdn_student_roster WHERE "SeedScenario"='ELIGIBLE')<>6
    OR EXISTS (SELECT 1 FROM qhdn_student_roster
      WHERE "SeedScenario" IS NOT NULL AND "SeedScenario"<>'ELIGIBLE') THEN
    RAISE EXCEPTION 'Expected 20 seeded students and an ELIGIBLE label only for the six students with completed OJT.';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM public."StudentCourseResults" grade
    WHERE grade."Status"='FAILED' AND grade."SourceReference" LIKE 'QHDN_HANDOFF_2026%') THEN
    RAISE EXCEPTION 'Expected seeded transcript history to include failed course attempts.';
  END IF;
  IF EXISTS (
    SELECT result."StudentID",result."AcademicPeriodID"
    FROM public."StudentCourseResults" result
    JOIN public."Students" student ON student."StudentID"=result."StudentID"
    JOIN public."Users" account ON account."UserID"=student."UserID"
    JOIN qhdn_student_roster roster ON roster."StudentCode"=student."StudentCode" AND roster."Email"=account."Email"
    WHERE result."SourceReference" LIKE 'QHDN_HANDOFF_2026%'
    GROUP BY result."StudentID",result."AcademicPeriodID"
    HAVING count(DISTINCT result."CourseID")>6
  ) THEN RAISE EXCEPTION 'A seeded student has more than six courses in one academic period.';
  END IF;
  IF EXISTS (
    SELECT 1 FROM qhdn_student_roster roster
    JOIN public."Users" account ON account."Email"=roster."Email"
    JOIN public."Students" student ON student."UserID"=account."UserID"
    JOIN public."OJTRegistrations" registration ON registration."StudentID"=student."StudentID"
    WHERE roster."RegistrationStatus" IS NULL
      AND NOT EXISTS (SELECT 1 FROM qhdn_student_ojt_success success WHERE success."StudentID"=student."StudentID")
  ) THEN RAISE EXCEPTION 'The seeded students without an OJT application must have no registration row.';
  END IF;
END $verify_qhdn_seed_students$;


