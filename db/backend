CREATE OR REPLACE FUNCTION public."RecruitmentOccupiedSlots"(position_id integer) RETURNS integer
LANGUAGE sql VOLATILE SET search_path=public,pg_catalog AS $$
SELECT count(*)::int FROM (
  SELECT r."StudentID" FROM "StudentEnterpriseCoordination" co JOIN "OJTRegistrations" r USING("RegistrationID")
  WHERE co."PositionID"=position_id AND co."Decision"='ACCEPTED'
  UNION SELECT ia."StudentID" FROM "InternshipAssignments" ia WHERE ia."PositionID"=position_id AND COALESCE(upper(ia."Status"),'ASSIGNED') NOT IN ('CANCELLED','CANCELED')
) used_students;
$$;
CREATE OR REPLACE FUNCTION public."GuardRecruitmentCampaign"() RETURNS trigger
LANGUAGE plpgsql SET search_path=public,pg_catalog AS $$ BEGIN
IF TG_OP='UPDATE' AND (ROW(NEW."OJTSemesterID",NEW."StartsAt",NEW."ScheduleVersion") IS DISTINCT FROM ROW(OLD."OJTSemesterID",OLD."StartsAt",OLD."ScheduleVersion") OR NEW."EndsAt"<OLD."EndsAt") THEN
  RAISE EXCEPTION 'Campaign may only extend its end; identity and start are fixed' USING ERRCODE='23514'; END IF;
IF NEW."ScheduleVersion">=2 AND (NEW."StartsAt" IS NULL OR NEW."EndsAt" IS NULL OR NEW."StartsAt">=NEW."EndsAt") THEN
  RAISE EXCEPTION 'Invalid campaign bounds' USING ERRCODE='23514'; END IF;
RETURN NEW; END $$;
CREATE OR REPLACE FUNCTION public."GuardRecruitmentRound"() RETURNS trigger
LANGUAGE plpgsql SET search_path=public,pg_catalog AS $$
BEGIN
PERFORM pg_advisory_xact_lock(hashtext('academic-calendar'));
IF TG_OP='UPDATE' THEN
  IF ROW(NEW."CampaignID",NEW."RoundNumber",NEW."OJTSemesterID",NEW."AcademicPeriodID",NEW."StartsAt",NEW."PostingStartsAt",NEW."ApplicationStartsAt",NEW."ResultsStartsAt")
  IS DISTINCT FROM ROW(OLD."CampaignID",OLD."RoundNumber",OLD."OJTSemesterID",OLD."AcademicPeriodID",OLD."StartsAt",OLD."PostingStartsAt",OLD."ApplicationStartsAt",OLD."ResultsStartsAt") THEN
  RAISE EXCEPTION 'Round identities and phase start times are immutable' USING ERRCODE='23514'; END IF;
  IF ROW(NEW."EndsAt",NEW."PostingEndsAt",NEW."ApplicationEndsAt",NEW."ResultsEndsAt") IS DISTINCT FROM ROW(OLD."EndsAt",OLD."PostingEndsAt",OLD."ApplicationEndsAt",OLD."ResultsEndsAt") THEN
  IF OLD."Status"<>'OPEN' OR OLD."ResultsFinalizedAt" IS NOT NULL OR NEW."EndsAt"<>NEW."ResultsEndsAt"
    OR NEW."PostingEndsAt"<OLD."PostingEndsAt" OR NEW."ApplicationEndsAt"<OLD."ApplicationEndsAt" OR NEW."ResultsEndsAt"<OLD."ResultsEndsAt"
    OR (NEW."PostingEndsAt" IS DISTINCT FROM OLD."PostingEndsAt" AND NOT (OLD."PostingStartsAt"<=clock_timestamp() AND clock_timestamp()<OLD."PostingEndsAt"))
    OR (NEW."ApplicationEndsAt" IS DISTINCT FROM OLD."ApplicationEndsAt" AND NOT (OLD."ApplicationStartsAt"<=clock_timestamp() AND clock_timestamp()<OLD."ApplicationEndsAt"))
    OR (NEW."ResultsEndsAt" IS DISTINCT FROM OLD."ResultsEndsAt" AND NOT (OLD."ResultsStartsAt"<=clock_timestamp() AND clock_timestamp()<OLD."ResultsEndsAt")) THEN
    RAISE EXCEPTION 'Only extend an open phase; closed application intake cannot reopen' USING ERRCODE='23514'; END IF;
  END IF;
  IF OLD."ResultsFinalizedAt" IS NOT NULL AND NEW IS DISTINCT FROM OLD THEN
  RAISE EXCEPTION 'Finalized recruitment round is immutable' USING ERRCODE='23514'; END IF;
END IF;
IF NEW."CampaignID" IS NULL THEN RETURN NEW; END IF;
IF NEW."RoundNumber" IS NULL OR NEW."RoundNumber"<1 OR NEW."StartsAt">=NEW."EndsAt" THEN
  RAISE EXCEPTION 'Invalid recruitment child schedule' USING ERRCODE='23514'; END IF;
IF NOT EXISTS(SELECT 1 FROM "RecruitmentCampaigns" c WHERE c."CampaignID"=NEW."CampaignID" AND c."OJTSemesterID"=NEW."OJTSemesterID"
  AND (c."ScheduleVersion"=1 OR (NEW."StartsAt">=c."StartsAt" AND NEW."EndsAt"<=c."EndsAt"))) THEN
  RAISE EXCEPTION 'Child must belong to its campaign and fit within its dates' USING ERRCODE='23514'; END IF;
IF EXISTS(SELECT 1 FROM "RecruitmentCampaigns" c WHERE c."CampaignID"=NEW."CampaignID" AND c."ScheduleVersion"=3) AND (
  NEW."PostingStartsAt" IS NULL OR NEW."PostingEndsAt" IS NULL OR NEW."ApplicationStartsAt" IS NULL
  OR NEW."ApplicationEndsAt" IS NULL OR NEW."ResultsStartsAt" IS NULL OR NEW."ResultsEndsAt" IS NULL
  OR NOT (NEW."StartsAt"=NEW."PostingStartsAt" AND NEW."EndsAt"=NEW."ResultsEndsAt"
  AND NEW."PostingStartsAt"<NEW."PostingEndsAt" AND NEW."PostingEndsAt"<=NEW."ApplicationStartsAt"
  AND NEW."ApplicationStartsAt"<NEW."ApplicationEndsAt" AND NEW."ResultsStartsAt"=NEW."ApplicationStartsAt"
  AND NEW."ResultsEndsAt">NEW."ApplicationEndsAt")) THEN
  RAISE EXCEPTION 'Invalid posting/application/response intervals: review starts with applications and ends later' USING ERRCODE='23514'; END IF;
IF EXISTS(SELECT 1 FROM "RecruitmentWindows" w WHERE w."OJTSemesterID"=NEW."OJTSemesterID" AND w."WindowID"<>NEW."WindowID"
  AND w."StartsAt"<NEW."EndsAt" AND w."EndsAt">NEW."StartsAt") THEN
  RAISE EXCEPTION 'Recruitment rounds cannot overlap' USING ERRCODE='23514'; END IF;
IF TG_OP='INSERT' AND EXISTS(SELECT 1 FROM "RecruitmentWindows" w WHERE w."CampaignID"=NEW."CampaignID"
  AND (w."RoundNumber">=NEW."RoundNumber" OR w."EndsAt">NEW."StartsAt")) THEN
  RAISE EXCEPTION 'Child rounds must follow their sequence' USING ERRCODE='23514'; END IF;
IF NEW."Status"='OPEN' AND (TG_OP='INSERT' OR OLD."Status" IS DISTINCT FROM 'OPEN') AND EXISTS(
  SELECT 1 FROM "RecruitmentWindows" w WHERE w."OJTSemesterID"=NEW."OJTSemesterID" AND w."WindowID"<>NEW."WindowID"
  AND w."StartsAt"<NEW."StartsAt" AND (w."EndsAt">clock_timestamp() OR w."ResultsFinalizedAt" IS NULL)) THEN
  RAISE EXCEPTION 'Previous child must end and its results must be finalized before opening' USING ERRCODE='23514'; END IF;
IF (NEW."ResultsFinalizedAt" IS NULL)<>(NEW."ResultsFinalizedBy" IS NULL) THEN
  RAISE EXCEPTION 'Finalization actor is required' USING ERRCODE='23514'; END IF;
IF NEW."ResultsFinalizedAt" IS NOT NULL AND (NEW."EndsAt">clock_timestamp()) THEN
  RAISE EXCEPTION 'Round must end before finalization' USING ERRCODE='23514'; END IF;
RETURN NEW;
END $$;
CREATE OR REPLACE FUNCTION public."CarryForwardRecruitmentPosts"(target_id integer) RETURNS integer
LANGUAGE plpgsql SET search_path=public,pg_catalog AS $$
DECLARE target record; source record; copied_id integer; previous_id integer; copied integer:=0;
BEGIN
PERFORM pg_advisory_xact_lock(hashtext('academic-calendar'));
SELECT * INTO target FROM "RecruitmentWindows" WHERE "WindowID"=target_id FOR UPDATE;
IF NOT FOUND OR target."Status"<>'OPEN' OR target."ResultsFinalizedAt" IS NOT NULL OR target."PostingStartsAt" IS NULL OR clock_timestamp()>=target."PostingEndsAt" THEN RETURN 0; END IF;
SELECT "WindowID" INTO previous_id FROM "RecruitmentWindows" WHERE "OJTSemesterID"=target."OJTSemesterID" AND "StartsAt"<target."StartsAt" AND "ResultsFinalizedAt" IS NOT NULL ORDER BY "StartsAt" DESC,"WindowID" DESC LIMIT 1;
IF previous_id IS NULL THEN RETURN 0; END IF;
FOR source IN SELECT p.* FROM "RecruitmentPosts" p JOIN "Enterprises" e USING("EnterpriseID")
  WHERE p."WindowID"=previous_id AND p."EnterpriseManaged" AND p."ArchivedAt" IS NULL AND p."Status" IN ('PUBLISHED','CLOSED')
  AND (p."ReviewedAt" IS NULL OR p."ReviewedAt"=p."PublishedAt") AND e."Status"='ACTIVE' AND e."DeletedAt" IS NULL
  AND EXISTS(SELECT 1 FROM "RecruitmentPostPositions" pp JOIN "InternshipPositions" pos USING("PositionID") WHERE pp."PostID"=p."PostID" AND pos."DeletedAt" IS NULL AND pos."ArchivedAt" IS NULL AND pos."Capacity">public."RecruitmentOccupiedSlots"(pos."PositionID"))
LOOP
  INSERT INTO "RecruitmentPosts" ("EnterpriseID","OJTSemesterID","WindowID","Title","Content","Benefits","ApplicationInstructions","Status","PublishedAt","DeadlineAt","CreatedBy","EnterpriseManaged","SourcePostID")
  VALUES(source."EnterpriseID",source."OJTSemesterID",target_id,source."Title",source."Content",source."Benefits",source."ApplicationInstructions",'PUBLISHED',now(),target."ApplicationEndsAt",source."CreatedBy",true,source."PostID")
  ON CONFLICT ("WindowID","SourcePostID") WHERE "SourcePostID" IS NOT NULL DO NOTHING RETURNING "PostID" INTO copied_id;
  IF copied_id IS NULL THEN CONTINUE; END IF;
  INSERT INTO "RecruitmentPostPositions" ("PostID","PositionID","EnterpriseID","OJTSemesterID")
  SELECT copied_id,pp."PositionID",pp."EnterpriseID",pp."OJTSemesterID" FROM "RecruitmentPostPositions" pp JOIN "InternshipPositions" pos USING("PositionID") WHERE pp."PostID"=source."PostID" AND pos."DeletedAt" IS NULL AND pos."ArchivedAt" IS NULL AND pos."Capacity">public."RecruitmentOccupiedSlots"(pos."PositionID");
  UPDATE "InternshipPositions" pos SET "Status"='OPEN',"RemainingSlots"=GREATEST(0,pos."Capacity"-public."RecruitmentOccupiedSlots"(pos."PositionID")) WHERE EXISTS(SELECT 1 FROM "RecruitmentPostPositions" pp WHERE pp."PostID"=copied_id AND pp."PositionID"=pos."PositionID");
  INSERT INTO "AuditLogs" ("UserID","Action","EntityType","EntityID","Detail") VALUES(target."CreatedBy",'CONTINUE_REMAINING_SLOTS','RecruitmentPosts',copied_id,jsonb_build_object('system',true,'sourcePostId',source."PostID",'windowId',target_id)::text);
  copied:=copied+1;
END LOOP;
RETURN copied;
END $$;
CREATE OR REPLACE FUNCTION public."GuardRecruitmentCapacity"() RETURNS trigger
LANGUAGE plpgsql SET search_path=public,pg_catalog AS $$
DECLARE student_id integer; cap integer;
BEGIN
IF NEW."Decision"<>'ACCEPTED' THEN RETURN NEW; END IF;
IF TG_OP='UPDATE' AND OLD."Decision"='ACCEPTED' THEN RETURN NEW; END IF;
PERFORM pg_advisory_xact_lock(hashtext('academic-calendar'));
SELECT "StudentID" INTO student_id FROM "OJTRegistrations" WHERE "RegistrationID"=NEW."RegistrationID";
IF EXISTS(SELECT 1 FROM "StudentEnterpriseCoordination" co JOIN "OJTRegistrations" r USING("RegistrationID") WHERE r."StudentID"=student_id AND co."OJTSemesterID"=NEW."OJTSemesterID" AND co."Decision"='ACCEPTED' AND co."CoordinationID"<>NEW."CoordinationID") THEN
  RAISE EXCEPTION 'Student already confirmed in this OJT semester' USING ERRCODE='23514'; END IF;
SELECT "Capacity" INTO cap FROM "InternshipPositions" WHERE "PositionID"=NEW."PositionID" FOR UPDATE;
IF cap IS NULL OR public."RecruitmentOccupiedSlots"(NEW."PositionID")>=cap THEN
  RAISE EXCEPTION 'Shared semester capacity is exhausted' USING ERRCODE='23514'; END IF;
RETURN NEW;
END $$;
DROP TRIGGER IF EXISTS "TR_RecruitmentCapacity" ON public."StudentEnterpriseCoordination";
CREATE TRIGGER "TR_RecruitmentCapacity" BEFORE INSERT OR UPDATE OF "Decision" ON public."StudentEnterpriseCoordination" FOR EACH ROW EXECUTE FUNCTION public."GuardRecruitmentCapacity"();
CREATE OR REPLACE FUNCTION public."GuardApplicationSnapshot"() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN
IF OLD."ApplicationSnapshot" IS NOT NULL AND NEW."ApplicationSnapshot" IS DISTINCT FROM OLD."ApplicationSnapshot" THEN
  RAISE EXCEPTION 'Submitted application snapshot is immutable' USING ERRCODE='23514'; END IF;
RETURN NEW; END $$;
DROP TRIGGER IF EXISTS "TR_ApplicationSnapshot" ON public."JobApplications";
CREATE TRIGGER "TR_ApplicationSnapshot" BEFORE UPDATE ON public."JobApplications" FOR EACH ROW EXECUTE FUNCTION public."GuardApplicationSnapshot"();
REVOKE ALL ON FUNCTION public."CarryForwardRecruitmentPosts"(integer),public."RecruitmentOccupiedSlots"(integer) FROM PUBLIC;
DO $permissions$ BEGIN IF EXISTS(SELECT 1 FROM pg_roles WHERE rolname='service_role') THEN GRANT EXECUTE ON FUNCTION public."CarryForwardRecruitmentPosts"(integer),public."RecruitmentOccupiedSlots"(integer) TO service_role; END IF; END $permissions$;

ALTER TABLE public."CohortCurriculumPeriods" ENABLE ROW LEVEL SECURITY;
ALTER TABLE public."RecruitmentWindows" ENABLE ROW LEVEL SECURITY;
REVOKE ALL ON TABLE public."CohortCurriculumPeriods",public."RecruitmentWindows" FROM PUBLIC;
DO $permissions$ BEGIN
IF EXISTS(SELECT 1 FROM pg_roles WHERE rolname='anon') THEN
  REVOKE ALL ON TABLE public."CohortCurriculumPeriods",public."RecruitmentWindows" FROM anon;
END IF;
IF EXISTS(SELECT 1 FROM pg_roles WHERE rolname='authenticated') THEN
  REVOKE ALL ON TABLE public."CohortCurriculumPeriods",public."RecruitmentWindows" FROM authenticated;
END IF;
IF EXISTS(SELECT 1 FROM pg_roles WHERE rolname='service_role') THEN
  GRANT SELECT,INSERT,UPDATE,DELETE ON TABLE public."CohortCurriculumPeriods",public."RecruitmentWindows" TO service_role;
END IF;
END $permissions$;

